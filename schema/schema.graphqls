"""
input UpdateAssessmentInput {
    "The assessment ID"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The assessment source ID"
    sourceId: UUID
    "The assessment content type"
    contentType: String @Size(max: 128)
    "The assessment content body"
    contentBody: String @Size(max: 2048)
    "The confidence"
    confidence: Confidence
    "The likelihood"
    likelihood: Float @Range(min: 0.0, max: 1.0)
}

"""
The input type for the sync assessment request
"""
input syncAssessmentInput {
    "The assessment ID to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The ID of the object upon which this assessment belongs"
    targetObjectId: UUID
    "The type of the object upon which this assessment belongs"
    targetObjectType: ObjectType
    "The owner of this assessment"
    owner: String @Size(max: 128)
    "The associated source ID"
    sourceId: UUID
    "The time of assessment"
    timeOfAssessment: DateTime
    "The confidence"
    confidence: Confidence
    "The likelihood"
    likelihood: Float @Range(min: 0.0, max: 1.0)
    "The assessment content type"
    contentType: String @Size(max: 128)
    "The assessment content body"
    contentBody: String @Size(max: 2048)
}

