}

# ************************************************
# ***************** SOURCE TYPES *****************
# ************************************************

"""
An Source holds the information from one report about a real life entity
"""
type Source implements Auditable & Verifiable @uniqueOn(fields: ["providerId", "identifier"]) @uniqueOn(fields: ["uri"]) {
    "The source ID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The source name"
    name: String! @sortable
    "The source description"
    description: String @sortable
    "The date and time at which the data was reported"
    dateOfReport: DateTime! @sortable
    "The date and time of the information in the source"
    dateOfInformation: DateTime! @sortable
    "The date and time of when the information was inserted into ATOMS"
    dateOfCreation: DateTime! @sortable
    "The primary topic"
    primaryTopic: String @sortable
    "The secondary topic"
    secondaryTopic: String @sortable
    "The provider ID"
    providerId: UUID! @sortable
    "The external resource identifier"
    identifier: String! @sortable
    "The external resource URI"
    uri: String @sortable
    "The external resource ACM"
    dataAcm: ACM! @sortable
    "Audit log events for this source"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this source"
    history (
        "The history filter"
        filter: HistoryFilter
    ): SourcePage!
    "The resolvable provider"
    provider: Provider
    "The attributes associated with this source"
    attributes (
        "The attribute filter"
        filter: AttributeFilter
    ): AttributePage!
    "The assessments associated with this source"
    assessments (
        "The assessment filter"
        filter: SourceAssessmentFilter
    ): AssessmentPage!
    "The observations associated with this source"
    observations (
        "The observation filter"
        filter: SourceObservationFilter
    ): ObservationPage!
    "The activities associated with this source"
    activities (
        "The activity filter"
        filter: SourceActivityFilter
    ): ActivityPage!
    "The relationships associated with this source"
    relationships (
        "The relationship filter"
        filter: SourceRelationshipFilter
    ): RelationshipPage!
    "The most recent object verification"
    lastVerified: Verification!
}

"""
A page of sources
"""
type SourcePage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Source!]!
}

"""
A query for source objects
"""
input SourceQuery {
    "A list of source IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "A date of report time query"
    dateOfReport: TimeQuery
    "A date of information time query"
    dateOfInformation: TimeQuery
    "A creation date query"
    dateOfCreation: TimeQuery
    "A string query for the primary topic"
    primaryTopic: StringQuery
    "A string query for the secondary topic"
    secondaryTopic: StringQuery
    "A list of provider IDs to match"
    providerIds: [UUID!] @ContainerNotEmpty
    "A list of identifiers to match"
    identifiers: [String!] @ContainerNotEmpty
    "A URI match query"
    uri: StringQuery
    "Search for a string match in either the name, identifier, or uri field"
    text: StringQuery
    "A provider subquery"
    providers: SourceProviderSubQuery
    "Paging parameters"
    pageParams: PageParams
}

"A sub query for matching against providers"
input SourceProviderSubQuery {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "The URL match query"
    url: StringQuery
    "A description match query"
    description: StringQuery
    "A list of originator IDs to match"
    originatorIds: [UUID!] @ContainerNotEmpty
}

"A Sub-graph filter for source objects"
input SourceFilter {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "A date of report time query"
    dateOfReport: TimeQuery
    "A date of information time query"
    dateOfInformation: TimeQuery
    "A creation date time query"
    dateOfCreation: TimeQuery
    "A string query for the primary topic"
    primaryTopic: StringQuery
    "A string query for the secondary topic"
    secondaryTopic: StringQuery
    "A list of identifiers to match"
    identifiers: [String!] @ContainerNotEmpty
    "A URI match query"
    uri: StringQuery
    "Search for a string match in either the name, identifier, or uri field"
    text: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
The input type for the create source request
"""
input CreateSourceInput {
    "The source name"
    name: String! @Size(max: 128)
    "The source description"
    description: String @Size(max: 512)
    "The date at which the data was reported"
    dateOfReport: DateTime!
    "The date and time of the information in the source"
    dateOfInformation: DateTime!
    "The primary topic"
    primaryTopic: String @Size(max: 64)
    "The secondary topic"
    secondaryTopic: String @Size(max: 64)
    "The tags"
    tags: [String!] @Size(max: 128)
    "The provider ID"
    providerId: UUID!
    "The ACM"
    acm: ACM!
    "The external resource identifier"
    identifier: String! @Size(max: 128)
    "The external resource URI"
    uri: String @Size(max: 512)
    "The external resource ACM"
    dataAcm: ACM!
}

"""
The input type for the update source request
"""
input UpdateSourceInput {
    "The ID of the source to update"
    id: UUID!
    "The source name"
    name: String @Size(max: 128)
    "The source description"
    description: String @Size(max: 512)
    "The date at which the data was reported"
    dateOfReport: DateTime
    "The date and time of the information in the source"
    dateOfInformation: DateTime
    "The primary topic"
    primaryTopic: String @Size(max: 64)
    "The secondary topic"
    secondaryTopic: String @Size(max: 64)
    "The tags"
    tags: [String!] @Size(max: 128)
    "The provider ID"
    providerId: UUID
    "The ACM"
    acm: ACM
    "The external resource identifier"
    identifier: String @Size(max: 128)
    "The external resource URI"
    uri: String @Size(max: 512)
    "The external resource ACM"
    dataAcm: ACM
}

"""
The input type for the sync source request
"""
input SyncSourceInput {
    "The ID of the source to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The source name"
    name: String @Size(max: 128)
    "The source description"
    description: String @Size(max: 512)
    "The date at which the data was reported"
    dateOfReport: DateTime
    "The date and time of the information in the source"
    dateOfInformation: DateTime
    "The date and time of when the information was inserted into ATOMS"
