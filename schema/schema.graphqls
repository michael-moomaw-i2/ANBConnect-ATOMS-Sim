scalar Date
scalar DateTime
scalar Long
scalar JSON
scalar UUID
scalar ACM
scalar Preferences
scalar GeoJSON

type Query {
    # ************************************************
    # ********************* MISC *********************
    # ************************************************

    "Send a test request to the server"
    greeting: String

    # ************************************************
    # ******************** AUDIT *********************
    # ************************************************

    "Get the audit event with the given ID"
    audit(query: IdQuery!): AuditLog

    "Get the audit events that match the given query"
    audits(query: AuditQuery!): AuditLogPage!

    # ************************************************
    # ****************** ORIGINATOR ******************
    # ************************************************

    "Get the originator with the given ID"
    originator(query: IdQuery!): Originator

    "Get the originators for the given query"
    originators(query: OriginatorQuery!): OriginatorPage!

    "Get the originator history for the given query"
    originatorHistory(query: HistoryQuery!): OriginatorPage!

    # ************************************************
    # ******************* PROVIDER *******************
    # ************************************************

    "Get the provider with the given ID"
    provider(query: IdQuery!): Provider

    "Get the providers for the given query"
    providers(query: ProviderQuery!): ProviderPage!

    "Get the provider history for the given query"
    providerHistory(query: HistoryQuery!): ProviderPage!

    # ************************************************
    # ******************** SOURCE ********************
    # ************************************************
    "Get the source with the given ID"
    source(query: IdQuery!): Source

    "Get the sources for the given query"
    sources(query: SourceQuery!): SourcePage!

    "Get the source history for the given query"
    sourceHistory(query: HistoryQuery!): SourcePage!

    # ************************************************
    # ********************* NODE *********************
    # ************************************************

    "Get the node with the given ID"
    node(query: IdQuery!): Node

    "Get the nodes for the given query"
    nodes(query: NodeQuery!): NodePage!

    "Get the node history for the given query"
    nodeHistory(query: HistoryQuery!): NodePage!

    # ************************************************
    # ******************* ATTRIBUTE ******************
    # ************************************************

    "Get the attribute with the given ID"
    attribute(query: IdQuery!): Attribute

    "Get the attributes for the given query"
    attributes(query: AttributeQuery!): AttributePage!

    "Get the attribute history for the given query"
    attributeHistory(query: HistoryQuery!): AttributePage!

    # ************************************************
    # ****************** OBSERVATION *****************
    # ************************************************

    "Get the observation with the given ID"
    observation(query: IdQuery!): Observation

    "Get the observations for the given query"
    observations(query: ObservationQuery!): ObservationPage!

    "Get the observation history for the given query"
    observationHistory(query: HistoryQuery!): ObservationPage!

    # ************************************************
    # ******************* ACTIVITY *******************
    # ************************************************

    "Get the activity with the given ID"
    activity(query: IdQuery!): Activity

    "Get the activities for the given query"
    activities(query: ActivityQuery!): ActivityPage!

    "Get the activity history for the given query"
    activityHistory(query: HistoryQuery!): ActivityPage!

    # ************************************************
    # ***************** RELATIONSHIP *****************
    # ************************************************

    "Get the relationship with the given ID"
    relationship(query: IdQuery!): Relationship

    "Get the relationships for the given query"
    relationships(query: RelationshipQuery!): RelationshipPage!

    "Get the relationship history for the given query"
    relationshipHistory(query: HistoryQuery!): RelationshipPage!

    # ************************************************
    # ******************* COMMENT ********************
    # ************************************************

    "Get the comment with the given ID"
    comment(query: IdQuery!): Comment

    "Get the comments for the given query"
    comments(query: CommentQuery!): CommentPage!

    "Get the comment history for the given query"
    commentHistory(query: HistoryQuery!): CommentPage!

    # ************************************************
    # ****************** ASSESSMENT ******************
    # ************************************************

    "Get the assessment with the given ID"
    assessment(query: IdQuery!): Assessment

    "Get the assessments for the given query"
    assessments(query: AssessmentQuery!): AssessmentPage!

    "Get the assessment history for the given query"
    assessmentHistory(query: HistoryQuery!): AssessmentPage!

    # ************************************************
    # **************** NOTIFICATIONS *****************
    # ************************************************

    "Get the notification with the given ID"
    notification(query: IdQuery!): Notification

    "Get the notifications for the given query"
    notifications(query: NotificationQuery!): NotificationPage!

    "Get the notification history for the given query"
    notificationHistory(query: HistoryQuery!): NotificationPage!

    # ************************************************
    # ******************* ONTOLOGY *******************
    # ************************************************

    "Get the ontology class with the given IRI"
    ontologyClass(query: IriQuery!): OntologyClass

    "Find ontology classes with the given query- name will search on both name and aliases"
    ontologyClasses(query: OntologyClassQuery!): OntologyClassPage!

    "Get the ontology attribute with the given IRI"
    ontologyAttribute(query: IriQuery!): OntologyAttribute

    "Find ontology attributes with the given query"
    ontologyAttributes(query: OntologyQuery!): OntologyAttributePage!

    "Get the ontology relationship with the given IRI"
    ontologyRelationship(query: IriQuery!): OntologyRelationship

    "Find ontology relationships with the given query"
    ontologyRelationships(query: OntologyQuery!): OntologyRelationshipPage!

    "Returns true if the given resourceIri is for a valid loaded ontology"
    isValidOntologyResource(input: IsValidOntologyResourceInput!): Boolean

    "Returns a list of all valid countries"
    getAllCountries: [CountryInfo!]!

    "Returns a list of all valid COCOMs"
