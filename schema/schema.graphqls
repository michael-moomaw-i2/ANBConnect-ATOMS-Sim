        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this provider"
    history (
        "The history filter"
        filter: HistoryFilter
    ): ProviderPage!
    "The resolvable originator object"
    originator: Originator
    "The sources associated with this provider"
    sources (
        "The source filter"
        filter: SourceFilter
    ): SourcePage!
}

"""
