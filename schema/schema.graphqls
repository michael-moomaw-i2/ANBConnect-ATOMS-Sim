# ************************************************
# *************** ACTIVITY TYPES *****************
# ************************************************
"""
Activity data about one or more observations on a node
"""
type Activity implements Auditable & Verifiable {
    "The activity ID"
    id: UUID! @sortable
    "The activity version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The labels"
    labels: [String!] @sortable
    "The class IRI for this activity"
    classIri: String! @sortable
    "The class name for this activity"
    className: String! @sortable
    "The name of the activity"
    name: String! @sortable
    "The description"
    description: String @sortable
    "The activity state"
    state: String! @sortable
    "The source ID"
    sourceId: UUID @sortable
    "The node ID"
    nodeId: UUID! @sortable
    "A list of observations for this activity"
    observationIds: [UUID!] @sortable
    "The start time"
    startTime: DateTime! @sortable
    "The end time"
    endTime: DateTime! @sortable
    "Audit log events for this activity object"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this activity object"
    history (
        "The history filter"
        filter: HistoryFilter
    ): ActivityPage!
    "The source for this activity"
    source: Source
    "The node for this activity"
    node: Node
    "The attributes associated to this activity"
    attributes(
        "The attribute filter"
        filter: AttributeFilter
    ): AttributePage!
    "The observations associated with this activity"
    observations (
        "The Observation filter"
        filter: ActivityObservationFilter
    ): ObservationPage!
    "The comments associated with this activity"
    comments (
        "The comment filter"
        filter: CommentFilter
    ): CommentPage!
    assessments (
        "The assessment filter"
        filter: AssessmentFilter
    ): AssessmentPage!
    "The most recent object verification"
    lastVerified: Verification!
    "The ontology class for this activity"
    ontologyClass: OntologyClass!
}

