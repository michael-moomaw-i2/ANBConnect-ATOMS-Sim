# ************************************************
# **************** ONTOLOGY TYPES ****************
# ************************************************

"""
A query for ontology class objects
"""
input OntologyClassQuery {
    "A list of IRIs to match"
    iris: [String!] @ContainerNotEmpty
    "A list of super class IRIs to get children of"
    superClassIris: [String!] @ContainerNotEmpty
    "A text match query to match against the object name"
    name: StringQuery
    "Whether we should only return root classes which have no parent"
    isRoot: Boolean
    "Whether the IRIs should be user visible"
    isVisible: Boolean
    "The page parameters"
    pageParams: PageParams
}

"""
A query for ontology objects
"""
input OntologyQuery {
    "A list of IRIs to match"
    iris: [String!] @ContainerNotEmpty
    "A text match query to match against the object name"
    name: StringQuery
    "A boolean query to search for user visible IRIs"
    isVisible: Boolean
    "The page parameters"
    pageParams: PageParams
}

"A query for getting by IRI"
input IriQuery {
    "The IRI"
    iri: String!
}

"A country code and name"
type CountryInfo {
    "The country code"
    countryCode: String!
    "The country name"
    countryName: String!
}

"An available attribute from the ontology"
type OntologyAttribute {
    "The ontology IRI"
    iri: String!
    "The ontology source"
    source: String!
