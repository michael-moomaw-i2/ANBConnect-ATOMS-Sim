    "get the collection status for a given provider ID"
    providerStatus(query: ProviderStatusQuery!): ProviderCollectionStatus

    "return a full list of all tracked originators and their provider statuses"
    collectionStatusReport: CollectionStatusReport

    # ************************************************
    # *************** OBJECT LIST **************
    # ************************************************

    "Get the object list with the given ID"
    objectList(query: IdQuery!): ObjectList

    "Get the object list for the given query"
    objectLists(query: ObjectListQuery!): ObjectListPage!

    "Get the object list history for the given query"
    objectListHistory(query: HistoryQuery!): ObjectListPage!

    # ************************************************
    # ***************** NODE CHANGES *****************
    # ************************************************

    "Get the node changes for the given query"
    nodeChanges(query: NodeChangeQuery!): NodeChangePage!

    # ************************************************
    # *************** USER PREFERENCES ***************
    # ************************************************

    "Get the user preferences for a given query"
    userPreferences(query: UserPreferencesQuery!): UserPreferences

    "Get the user preferences by IdQuery"
    userPreferencesById(query: IdQuery!): UserPreferences

    "Get the user preferences history for the given query"
    userPreferencesHistory(query: HistoryQuery!): UserPreferencesPage!

    # ************************************************
    # **************** BASEBALL CARD *****************
    # ************************************************

    "Get the baseball card with the given ID"
    baseballCard(query: IdQuery!): BaseballCard

    "Get the baseball cards for the given query"
    baseballCards(query: BaseballCardQuery!): BaseballCardPage!

    "Get the baseball card history for the given query"
    baseballCardHistory(query: HistoryQuery!): BaseballCardPage!

    # ************************************************
    # ***************** EOID RECORD ******************
    # ************************************************

    "Get the EOID record with the given ID or EOID"
    eoidRecord(query: EoidRecordIdQuery!): EoidRecord

    "Get the EOID records for the given query"
    eoidRecords(query: EoidRecordQuery!): EoidRecordPage!

    # ************************************************
    # ************** EMAIL SUBSCRIPTION **************
    # ************************************************

    "Get the email subscription with the given ID"
    emailSubscription(query: IdQuery!): EmailSubscription

    "Get the email subscriptions for the given query"
    emailSubscriptions(query: EmailSubscriptionQuery!): EmailSubscriptionPage!

    "Get the email subscription history for the given query"
    emailSubscriptionHistory(query: HistoryQuery!): EmailSubscriptionPage!

    # ************************************************
    # **************** ATOMS CONFIG ******************
    # ************************************************

    "Get the full list of valid activity states"
    activityStates: [String!]!

    # ************************************************
    # ************* COLLECTION LATENCY ***************
    # ************************************************

    "Get collection latency metrics with the given hours back and number of bins to query"
    collectionLatencyStats(query: CollectionLatencyStatsQuery!): CollectionLatencyStats

    # ************************************************
    # ************* ALERT SUBSCRIPTIONS **************
    # ************************************************

    "Get the alert subscription with the given ID"
    alertSubscription(query: IdQuery!): AlertSubscription

    "Get the alert subscriptions for the given query"
    alertSubscriptions(query: AlertSubscriptionQuery!): AlertSubscriptionPage!

    "Get the alert subscription history for the given query"
    alertSubscriptionHistory(query: HistoryQuery!): AlertSubscriptionPage!

    # ************************************************
    # ******************* ALERTS *********************
    # ************************************************

    "Get all alerts for the user"
    alerts(query: AlertQuery!): AlertPage!

    # ************************************************
    # ******************* TICKET *********************
    # ************************************************

    "Get the ticket with the given ID"
    ticket(query: IdQuery!): Ticket

    "Get the tickets for the given query"
    tickets(query: TicketQuery!): TicketPage!

    "Get the ticket history for the given query"
    ticketHistory(query: HistoryQuery!): TicketPage!

    # ************************************************
    # ******************* PROJECT ********************
    # ************************************************

    "Get the project with the given ID"
    project(query: IdQuery!): Project

    "Get the projects for the given query"
    projects(query: ProjectQuery!): ProjectPage!

    "Get the project history for the given query"
    projectHistory(query: HistoryQuery!): ProjectPage!
}

type Mutation {
    # ************************************************
    # ****************** ORIGINATOR ******************
    # ************************************************

    "Create an originator"
    createOriginator(input: CreateOriginatorInput!): Originator

    "Update an originator"
    updateOriginator(input: UpdateOriginatorInput!): Originator

    "Sync the originator data with the given input (usage restricted to DDIL)"
    syncOriginator(input: SyncOriginatorInput!): Originator

    "Delete an originator"
    deleteOriginator(input: DeleteByIdInput!): Boolean

    "Restore a deleted originator"
    restoreOriginator(input: RestoreInput!): Originator

    # ************************************************
    # ******************* PROVIDER *******************
    # ************************************************

    "Create a provider"
    createProvider(input: CreateProviderInput!): Provider

    "Update a provider"
    updateProvider(input: UpdateProviderInput!): Provider

    "Sync the provider data with the given input (usage restricted to DDIL)"
    syncProvider(input: SyncProviderInput!): Provider

    "Delete a provider"
    deleteProvider(input: DeleteByIdInput!): Boolean

    "Restore a deleted provider"
    restoreProvider(input: RestoreInput!): Provider


    # ************************************************
    # ******************** SOURCE ********************
    # ************************************************

    "Create a source"
    createSource(input: CreateSourceInput!): Source

    "Update a source"
    updateSource(input: UpdateSourceInput!): Source

    "Sync the source data with the given input (usage restricted to DDIL)"
    syncSource(input: SyncSourceInput!): Source

    "Delete a source"
    deleteSource(input: DeleteByIdInput!): Boolean

    "Restore a deleted source"
    restoreSource(input: RestoreInput!): Source

    "Verify an existing source"
    verifySource(input: VerifyInput!): Boolean!

    # ************************************************
    # ********************* NODE *********************
    # ************************************************

    "Create a node"
    createNode(input: CreateNodeInput!): Node

    "Update a node"
    updateNode(input: UpdateNodeInput!): Node

    "Sync the node data with the given input (usage restricted to DDIL)"
    syncNode(input: SyncNodeInput!): Node

    "Delete a node"
    deleteNode(input: DeleteByIdInput!): Boolean

    "Restore a deleted node"
    restoreNode(input: RestoreInput!): Node

    "Verify an existing node"
    verifyNode(input: VerifyInput!): Boolean!

    # ************************************************
    # ******************* ATTRIBUTE ******************
    # ************************************************

    "Create an attribute"
    createAttribute(input: CreateAttributeInput!): Attribute

    "Update an attribute"
    updateAttribute(input: UpdateAttributeInput!): Attribute

    "Sync the attribute data with the given input (usage restricted to DDIL)"
    syncAttribute(input: SyncAttributeInput!): Attribute

    "Delete an attribute"
    deleteAttribute(input: DeleteByIdInput!): Boolean

    "Restore a deleted attribute"
    restoreAttribute(input: RestoreInput!): Attribute

    "Verify an existing attribute"
    verifyAttribute(input: VerifyInput!): Boolean!

    # ************************************************
    # ****************** OBSERVATION *****************
    # ************************************************

    "Create an observation"
    createObservation(input: CreateObservationInput!): Observation

    "Update an observation"
    updateObservation(input: UpdateObservationInput!): Observation

    "Sync the observation data with the given input (usage restricted to DDIL)"
    syncObservation(input: SyncObservationInput!): Observation

    "Delete an observation"
    deleteObservation(input: DeleteByIdInput!): Boolean

    "Restore a deleted observation"
    restoreObservation(input: RestoreInput!): Observation

    "Verify an existing observation"
    verifyObservation(input: VerifyInput!): Boolean!

    # ************************************************
    # ******************* ACTIVITY *******************
    # ************************************************

    "Create an activity"
    createActivity(input: CreateActivityInput!): Activity

    "Update an activity"
    updateActivity(input: UpdateActivityInput!): Activity

    "Sync the activity data with the given input (usage restricted to DDIL)"
    syncActivity(input: SyncActivityInput!): Activity

    "Delete an activity"
    deleteActivity(input: DeleteByIdInput!): Boolean

    "Restore a deleted activity"
    restoreActivity(input: RestoreInput!): Activity

    "Verify an existing activity"
    verifyActivity(input: VerifyInput!): Boolean!

    # ************************************************
    # ***************** RELATIONSHIP *****************
    # ************************************************

    "Create a relationship between two nodes"
    createRelationship(input: CreateRelationshipInput!): Relationship

    "Update a relationship"
    updateRelationship(input: UpdateRelationshipInput!): Relationship

    "Sync the relationship data with the given input (usage restricted to DDIL)"
    syncRelationship(input: SyncRelationshipInput!): Relationship

    "Delete a relationship"
    deleteRelationship(input: DeleteByIdInput!): Boolean

    "Restore a deleted relationship"
    restoreRelationship(input: RestoreInput!): Relationship

    "Verify an existing relationship"
    verifyRelationship(input: VerifyInput!): Boolean!

    # ************************************************
    # ******************* COMMENT ********************
    # ************************************************

    "Create a new comment on a data object"
    createComment(input: CreateCommentInput!): Comment

    "Update an existing comment that belongs to the requesting user"
    updateComment(input: UpdateCommentInput!): Comment

    "Sync the comment data with the given input (usage restricted to DDIL)"
    syncComment(input: SyncCommentInput!): Comment

    "Delete a comment that belongs to the requesting user"
    deleteComment(input: DeleteByIdInput!): Boolean

    "Restore a deleted comment"
    restoreComment(input: RestoreInput!): Comment

    # ************************************************
    # ****************** ASSESSMENT ******************
    # ************************************************

    "Create a new assessment"
    createAssessment(input: CreateAssessmentInput!): Assessment

    "Update an existing assessment"
    updateAssessment(input: UpdateAssessmentInput!): Assessment

    "Sync the assessment data with the given input (DDIL usage)"
    syncAssessment(input: syncAssessmentInput!): Assessment

    "Delete an existing assessment"
    deleteAssessment(input: DeleteByIdInput!): Boolean

    "Restore a deleted assessment"
    restoreAssessment(input: RestoreInput!): Assessment

    # ************************************************
    # **************** NOTIFICATIONS *****************
    # ************************************************

    "Create a new notification"
    createNotification(input: CreateNotificationInput!): Notification

    "Update an existing notification"
    updateNotification(input: UpdateNotificationInput!): Notification

    "Sync the notification data with the given input (usage restricted to DDIL)"
    syncNotification(input: SyncNotificationInput!): Notification

    "Delete an notification"
    deleteNotification(input: DeleteByIdInput!): Boolean

    "Restore an notification"
    restoreNotification(input: RestoreInput!): Notification

    # ************************************************
    # ************** OBJECT LIST ***************
    # ************************************************

    "Create a new object list"
    createObjectList(input: CreateObjectListInput!): ObjectList

    "Update an existing object list"
    updateObjectList(input: UpdateObjectListInput!): ObjectList

    "Sync the object list data with the given input (usage restricted to DDIL)"
    syncObjectList(input: SyncObjectListInput!): ObjectList

    "Delete an object list"
    deleteObjectList(input: DeleteByIdInput!): Boolean

    "Restore an object list"
    restoreObjectList(input: RestoreInput!): ObjectList

    "Adjudicate queued updates to JAOL object lists and return the affected lists"
    adjudicateJaolUpdates(input: JaolAdjudicationInput!): [ObjectList!]!

    # ************************************************
    # ************** USER PREFERENCES ****************
    # ************************************************

    "Create new user preferences"
    createUserPreferences(input: CreateUserPreferencesInput!): UserPreferences

    "Update existing user preferences"
    updateUserPreferences(input: UpdateUserPreferencesInput!): UserPreferences

    "Delete user preferences"
    deleteUserPreferences(input: DeleteByIdInput!): Boolean

    "Restore user preferences"
    restoreUserPreferences(input: RestoreInput!): UserPreferences

    # ************************************************
    # **************** BASEBALL CARD *****************
    # ************************************************

    "Create a new baseball card"
    createBaseballCard(input: CreateBaseballCardInput!): BaseballCard

    "Update an existing baseball card"
    updateBaseballCard(input: UpdateBaseballCardInput!): BaseballCard

    "Sync the baseball card data with the given input (usage restricted to DDIL)"
    syncBaseballCard(input: SyncBaseballCardInput!): BaseballCard

    "Delete a baseball card"
    deleteBaseballCard(input: DeleteByIdInput!): Boolean

    "Restore a baseball card"
    restoreBaseballCard(input: RestoreInput!): BaseballCard

    # ************************************************
    # ***************** EOID RECORD ******************
    # ************************************************

    "Create the next EOID in the registry for the given input"
    createNextEoidRecord: EoidRecord

    # ************************************************
    # ************** EMAIL SUBSCRIPTION **************
    # ************************************************

    "Create a new email subscription"
    createEmailSubscription(input: CreateEmailSubscriptionInput!): EmailSubscription

    "Update an existing email subscription"
    updateEmailSubscription(input: UpdateEmailSubscriptionInput!): EmailSubscription

    "Sync the email subscription data with the given input (usage restricted to DDIL)"
    syncEmailSubscription(input: SyncEmailSubscriptionInput!): EmailSubscription

    "Delete an email subscription"
    deleteEmailSubscription(input: DeleteByIdInput!): Boolean

    "Restore an email subscription"
    restoreEmailSubscription(input: RestoreInput!): EmailSubscription

    # ************************************************
    # ************* ALERT SUBSCRIPTIONS **************
    # ************************************************

    "Create a new alert subscription"
    createAlertSubscription(input: CreateAlertSubscriptionInput!): AlertSubscription

    "Update an existing alert subscription"
    updateAlertSubscription(input: UpdateAlertSubscriptionInput!): AlertSubscription

    "Delete a alert subscription"
    deleteAlertSubscription(input: DeleteByIdInput!): Boolean

    # ************************************************
    # ******************* ALERTS *********************
    # ************************************************

    "Acknowledge the given alerts"
    acknowledgeAlerts(input: AcknowledgeAlertsInput!): Boolean

    # ************************************************
    # ******************* TICKET *********************
    # ************************************************

    "Create a new ticket"
    createTicket(input: CreateTicketInput!): Ticket

    "Update an existing ticket"
    updateTicket(input: UpdateTicketInput!): Ticket

    "Sync the ticket data with the given input (usage restricted to DDIL)"
    syncTicket(input: SyncTicketInput!): Ticket

    "Delete a ticket"
    deleteTicket(input: DeleteByIdInput!): Boolean

    "Restore a ticket"
    restoreTicket(input: RestoreInput!): Ticket

    # ************************************************
    # ******************* PROJECT ********************
    # ************************************************

    "Create a new project"
    createProject(input: CreateProjectInput!): Project

    "Update an existing project"
    updateProject(input: UpdateProjectInput!): Project

    "Sync the project data with the given input (usage restricted to DDIL)"
    syncProject(input: SyncProjectInput!): Project

    "Delete a project"
    deleteProject(input: DeleteByIdInput!): Boolean

    "Restore a project"
    restoreProject(input: RestoreInput!): Project

    # ************************************************
    # ******************** MISC **********************
    # ************************************************

    "Merge a originator node into the target node, deleting the originator node"
    mergeObjects(input: MergeObjectsInput!): Node

    "Re-sync the given object to the ESS node index"
    reSyncToEs(input: ReSyncToEsInput!): Boolean

    "Delete all smoke test data from the system"
    cleanUpSmokeTestData: Boolean

    "Purge data by tag from the system"
    purgeTaggedData(input: PurgeDataInput!): Boolean
}

type Subscription {
    "Returns a stream of AuditLogs"
    audits(input: AuditSubscription!): AuditLog!
}

# ************************************************
# ****************** DIRECTIVES ******************
# ************************************************
"""
A directive to specify that a field may be used as a sort parameter in paginated results
"""
directive @sortable on FIELD_DEFINITION

"""
A directive to specify the min and max values of a float
"""
directive @Range(
    min: Float
    max: Float
) on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

"""
A directive to specify the combination of fields for an object that must be unique
"""
directive @uniqueOn(
    "The object fields which make up the unique key"
    fields: [String!]
) repeatable on OBJECT

"""
A directive to specify the max length of a field
"""
directive @Size(
    min: Int! = 0,
    max: Int! = 2147483647,
    message: String! = "graphql.validation.Size.message"
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

"""
A directive to specify the max value of a Int field
"""
directive @Max(
    value: Int!
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

"""
A directive to specify the min value of a Int field
"""
directive @Min(
    value: Int!
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

"""
A directive to not allow empty lists
"""
directive @ContainerNotEmpty(
    message: String = "Must not be empty"
) on INPUT_FIELD_DEFINITION

# ************************************************
# ****************** INTERFACES ******************
# ************************************************
"""
A base object interface for ATOMS objects
"""
interface Auditable {
    "The object UUID"
    id: UUID!
    "The object version"
    version: Long!
    "The object ACM"
    acm: ACM!
}

"""
An interface for paginated data
"""
interface Page {
    "The total amount of all matching data"
    totalSize: Long!
    "Whether the total size has been capped at the max allowed value and the actual value is greater"
    totalSizeExceeded: Boolean!
    "A rollup ACM for the data list"
    rollupAcm: ACM
    "The data list"
    data: [Pageable!]!
}

"""
An interface for verifiable types
"""
interface Verifiable {
    "The most recent object verification"
    lastVerified: Verification!
}

# ************************************************
# ******************** UNIONS ********************
# ************************************************
"""
All pageable data types
"""
union Pageable = Originator | Provider | Source | Attribute | Relationship | Node | Comment | Notification | AuditLog |
    UserMetric | ObjectList | NodeChange | UserPreferences | Observation | Activity | BaseballCard | EoidRecord |
    EmailSubscription | Assessment | AlertSubscription | Alert | Ticket | Project

"""
All comment object types
"""
union CommentObject = Relationship | Attribute | Node | Activity | Assessment | Ticket

"""
All assessment object types
"""
union AssessmentObject = Relationship | Attribute | Node | Activity | Observation

"""
Object which may be referenced in node changes
"""
union NodeChangeRelatedObject = Attribute | Relationship | Comment | Observation | Activity | Assessment | ObjectList

# ************************************************
# ******************** COMMON ********************
# ************************************************
"""
A query for fetching an object by its UUID
"""
input IdQuery {
    "The object UUID to match"
    id: UUID!
}

"""
A query for timestamp data
"""
input TimeQuery {
    "The matched time is greater than this date time"
    gt: DateTime
    "The matched time is greater than or equal to this date time"
    gte: DateTime
    "The matched time is less than this date time"
    lt: DateTime
    "The matched time is less than or equal to this date time"
    lte: DateTime
    "A null time should match"
    matchNull: Boolean
}

"""
A query for the object type enumeration
"""
input ObjectTypeQuery {
    "The object type equals this value"
    is: ObjectType
    "The object type does not equal this value"
    not: ObjectType
    "The object type is one of these values"
    any: [ObjectType!] @ContainerNotEmpty
    "The object type is none of these values"
    none: [ObjectType!] @ContainerNotEmpty
}

"""
A query for the confidence enumeration
"""
input ConfidenceQuery {
    "The confidence equals this value"
    is: Confidence
    "The confidence does not equal this value"
    not: Confidence
    "The confidence is one of these values"
    any: [Confidence!] @ContainerNotEmpty
    "The confidence is none of these values"
    none: [Confidence!] @ContainerNotEmpty
}

"""
A query for the likelihood float
"""
input LikelihoodQuery {
    "The likelihood is less than this value"
    lt: Float
    "The likelihood is less than or equal to this value"
    lte: Float
    "The likelihood is greater than this value"
    gt: Float
    "The likelihood is greater than or equal to this value"
    gte: Float
}

"""
A query for the source type enumeration
"""
input SourceTypeQuery {
    "The source type equals this value"
    is: SourceType
    "The source type does not equal this value"
    not: SourceType
    "The source type is one of these values"
    any: [SourceType!] @ContainerNotEmpty
    "The source type is none of these values"
    none: [SourceType!] @ContainerNotEmpty
}

"""
A query for the severity enumeration
"""
input SeverityQuery {
    "The object type equals this value"
    is: Severity
    "The object type does not equal this value"
    not: Severity
    "The object type is one of these values"
    any: [Severity!] @ContainerNotEmpty
    "The object type is none of these values"
    none: [Severity!] @ContainerNotEmpty
}

"""
A string match query
"""
input StringQuery {
    "An exact match string"
    equals: String
    "A not equals query"
    notEquals: String
    "A partial match string"
    contains: String
    "A not contains query"
    notContains: String
    "Multiple and style matches"
    and: [StringQuery!] @ContainerNotEmpty
    "Multiple or style matches"
    or: [StringQuery!] @ContainerNotEmpty
}

"""
A string list match query
"""
input StringQueryByList {
    "A is in given string list query"
    in: [String!] @ContainerNotEmpty
    "A is not in given string list query"
    notIn: [String!] @ContainerNotEmpty
}

"""
A UUID list match query
"""
input UuidQueryByList {
    "A is not in given UUID list query"
    in: [UUID!] @ContainerNotEmpty
    "A is not in given UUID list query"
    notIn: [UUID!] @ContainerNotEmpty
}

"""
An object history query
"""
input HistoryQuery {
    "A list of object IDs to match"
    ids: [UUID!]! @ContainerNotEmpty
    "The versions to include. Will return all history by default"
    versions: [Long!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
An object history filter
"""
input HistoryFilter {
    "The versions to include. Will return all history by default"
    versions: [Long!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
A geospatial query
"""
input GeoQuery {
    "The query GeoJson"
    queryGeoJson: GeoJSON!
    "The geospatial query type"
    queryType: GeoQueryType! = INTERSECTS
}

"""
The preferred provider filter
"""
input PreferredProviderFilter {
    "The providers to use"
    providerIds: [UUID!]
    "Use the preferred provider on the node if one is set"
    usePreferredProvider: Boolean
}

"""
A latest location query
"""
input LatestLocationQuery {
    "The geo query"
    geoQuery: GeoQuery
    "The preferred provider query"
    preferredProvider: PreferredProviderFilter
    "A query for the data start time"
    startTime: TimeQuery
    "A query for the data end time"
    endTime: TimeQuery
}

"""
An input to remove or add ids from a list
"""
input UpdateUuidList {
    "Ids to add"
    add: [UUID!]
    "Ids to remove"
    remove: [UUID!]
    "Replaces whole list with the given ids"
    replace: [UUID!]
}

"""
An input to update a simple label list
"""
input UpdateLabelList {
    "Strings to add"
    add: [String!] @Size(max: 128)
    "Strings to remove"
    remove: [String!] @Size(max: 128)
    "Replaces whole list with the given strings"
    replace: [String!] @Size(max: 128)
}

"""
An input to update an email address list
"""
input UpdateEmailList {
    "Strings to add"
    add: [String!] @Size(max: 256)
    "Strings to remove"
    remove: [String!] @Size(max: 256)
    "Replaces whole list with the given strings"
    replace: [String!] @Size(max: 256)
}

"""
An input to update a user DN list
"""
input UpdateUserList {
    "Strings to add"
    add: [String!] @Size(max: 512)
    "Strings to remove"
    remove: [String!] @Size(max: 512)
    "Replaces whole list with the given strings"
    replace: [String!] @Size(max: 512)
}

# ************************************************
# ****************** AUDIT TYPES *****************
# ************************************************
"""
An audit log entry that represents an action take against an object
"""
type AuditLog {
    "The audit log ID"
    id: UUID! @sortable
    "The action that was taken"
    action: Action! @sortable
    "The date/time of the action"
    timestamp: DateTime! @sortable
    "The user that performed the action"
    userId: String! @sortable
    "The type of object that was accessed"
    objectType: ObjectType! @sortable
    "The ID of the object"
    objectId: UUID! @sortable
    "The version of the object"
    objectVersion: Long! @sortable
    "The complex audit ID"
    complexAuditId: UUID @sortable
    "The complex audit log event object"
    complexAudit: ComplexAuditLog
    "The referenced object"
    object: Auditable
}

"""
A complex audit log event containing a JSON payload
"""
type ComplexAuditLog {
    "The complex"
    id: UUID!
    "The complex event type"
    action: ComplexEventType!
    "The complex event time"
    timestamp: DateTime!
    "The requesting user ID"
    userId: String!
    "The complex event payload"
    auditJson: JSON!
    "Other audits from this complex audit"
    relatedAudits: [AuditLog!]
}

"""
A page of audit events
"""
type AuditLogPage implements Page {
    "The total number of matching audits"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM of the data"
    rollupAcm: ACM
    "The data list"
    data: [AuditLog!]!
}

"""
A query for audit events
"""
input AuditQuery {
    "A list of audit IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "The action query"
    action: ActionQuery
    "The time query"
    timestamp: TimeQuery
    "A list of users to match"
    userIds: [String!] @ContainerNotEmpty
    "The object type query"
    objectType: ObjectTypeQuery
    "A list of object IDs to match"
    objectIds: [UUID!] @ContainerNotEmpty
    "A list of complex audit IDs to match"
    complexAuditIds: [UUID!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
A sub-graph filter for audit objects
"""
input AuditFilter {
    "The action query"
    action: ActionQuery
    "The time query"
    timestamp: TimeQuery
    "A list of users to match"
    userIds: [String!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
An input for the audit subscriptions
"""
input AuditSubscription {
    "The action query"
    action: ActionQuery
    "A list of users to match"
    userIds: [String!] @ContainerNotEmpty
    "The object type query"
    objectType: ObjectTypeQuery
}

"""
A query for the action enumeration
"""
input ActionQuery {
    "The action equals this value"
    is: Action
    "The action does not equal this value"
    not: Action
    "The action is one of these value"
    any: [Action!] @ContainerNotEmpty
    "The action is none of these value"
    none: [Action!] @ContainerNotEmpty
}

# ************************************************
# *************** ORIGINATOR TYPES ***************
# ************************************************
"""
An originator from which ATOMS consumes data
"""
type Originator implements Auditable @uniqueOn(fields: ["name"]) {
    "The originator UUID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The originator ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The originator name"
    name: String! @sortable
    "The originator description"
    description: String! @sortable
    "Audit log events for this originator"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this originator"
    history (
        "The history filter"
        filter: HistoryFilter
    ): OriginatorPage!
    "The providers associated with this originator"
    providers (
        "The provider filter"
        filter: ProviderFilter
    ): ProviderPage!
}

"""
A page of originators
"""
type OriginatorPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Originator!]!
}

"""
A query for originator objects
"""
input OriginatorQuery {
    "A list of originator IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "The page parameters"
    pageParams: PageParams
}

"""
The input type for the create originator request
"""
input CreateOriginatorInput {
    "The originator name"
    name: String! @Size(max: 128)
    "The originator description"
    description: String! @Size(max: 512)
    "The tags"
    tags: [String!] @Size(max: 128)
    "The ACM"
    acm: ACM!
}

"""
The input type for the update originator request
"""
input UpdateOriginatorInput {
    "The UUID of the originator to update"
    id: UUID!
    "The originator name"
    name: String @Size(max: 128)
    "The originator description"
    description: String @Size(max: 512)
    "The tags"
    tags: [String!] @Size(max: 128)
    "The ACM"
    acm: ACM
}

"""
The input type for the sync originator request
"""
input SyncOriginatorInput {
    "The UUID of the originator to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The originator name"
    name: String @Size(max: 128)
    "The originator description"
    description: String @Size(max: 512)
}

# ************************************************
# **************** PROVIDER TYPES ****************
# ************************************************

"""
A provider from which ATOMS imports data
"""
type Provider implements Auditable @uniqueOn(fields: ["name"]) {
    "The provider ID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The provider ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The provider name"
    name: String! @sortable
    "The provider URL"
    url: String @sortable
    "The provider description"
    description: String! @sortable
    "The default ACM"
    defaultAcm: ACM @sortable
    "The originator ID"
    originatorId: UUID! @sortable
    "Audit log events for this provider"
