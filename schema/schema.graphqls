# ************************************************
# ************** OBSERVATION TYPES ***************
# ************************************************
"""
Geospatial observation data for a node
"""
type Observation implements Auditable & Verifiable {
    "The observation ID"
    id: UUID! @sortable
    "The observation version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The labels"
    labels: [String!] @sortable
    "The class IRI for this observation"
    classIri: String! @sortable
    "The class name for this observation"
    className: String! @sortable
    "The original user input value prior to GeoJSON conversion (e.g. MGRS)"
    displayValue: String @sortable
    "The confidence"
    confidence: Confidence! @sortable
    "The source ID"
    sourceId: UUID! @sortable
    "The node ID"
    nodeId: UUID! @sortable
    "The GeoJSON geometry"
    geometry: GeoJSON! @sortable
    "The start time"
    startTime: DateTime @sortable
    "The end time"
    endTime: DateTime @sortable
    "Audit log events for this observation object"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this observation object"
    history (
        "The history filter"
        filter: HistoryFilter
    ): ObservationPage!
    "The source for this observation"
    source: Source
    "The node for this observation"
    node: Node
    "The activity for this observation"
    activities(
        "The activity filter"
        filter: ObservationActivityFilter
    ): ActivityPage!
    "The attributes associated to this observation"
    attributes(
        "The attribute filter"
        filter: AttributeFilter
    ): AttributePage!
    assessments (
        "The assessment filter"
        filter: AssessmentFilter
    ): AssessmentPage!
    "The resolvable ontology class"
    ontologyClass: OntologyClass
    "The most recent object verification"
    lastVerified: Verification!
}

"""
A page of observations
"""
type ObservationPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Observation!]!
}

"""
The input type for creating Observation objects
"""
input CreateObservationInput {
    "The ACM"
    acm: ACM!
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The class IRI for this observation"
    classIri: String! @Size(max: 512)
    "The original user input value prior to GeoJSON conversion (e.g. MGRS)"
    displayValue: String  @Size(max: 2048)
    "The confidence"
    confidence: Confidence! = UNKNOWN
    "The source ID"
    sourceId: UUID!
    "The node ID"
    nodeId: UUID!
    "The GeoJSON geometry"
    geometry: GeoJSON!
    "The start time"
    startTime: DateTime
    "The end time"
    endTime: DateTime
}

