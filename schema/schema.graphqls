    "A domain match query"
    domain: DomainQuery
    "A list of class IRIs to match"
    classIris: [String!] @ContainerNotEmpty
    "A class name match query"
    className: StringQuery
    "A list of Symbol Id Codes to match"
    symbolIdCodes: [String!] @ContainerNotEmpty
    "A list of allegiances to match"
    allegiances: [String!] @ContainerNotEmpty
    "A list of allegiance AORs to match"
    allegianceAors: [String!] @ContainerNotEmpty
    "A list of current AORs to match"
    currentAors: [String!] @ContainerNotEmpty
    "A list of AORs to match against either current AOR or allegiance AOR"
    aors: [String!] @ContainerNotEmpty
    "Is the object a NSO"
    isNso: Boolean
    "A list of object list IDs to filter against"
    objectListIds: [UUID!] @ContainerNotEmpty
    "Sources that this node is a shallow component of"
    componentSourceIds: [UUID!] @ContainerNotEmpty
    "A query for the custody category of a node"
    custodyCategory: CustodyCategoryQuery
}

"A sub-query for matching against sources"
input ObservationActivitySubQuery {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "A string query for the activity name"
    name: StringQuery
    "A string query for the description"
    description: StringQuery
    "A string query for the activity state"
    states: StringQuery
    "A list of source IDs to match"
    sourceIds: [UUID!] @ContainerNotEmpty
    "A list of node IDs to match"
    nodeIds: UuidQueryByList
    "The start time query"
    startTime: TimeQuery
    "The end time query"
    endTime: TimeQuery
}

