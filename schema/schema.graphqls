"""
A subscription to the email notification scheduling service
"""
type EmailSubscription {
    "The email subscription UUID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The email subscription ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The email subscription name"
    name: String! @sortable
    "The email subscription description"
    description: String! @sortable
    "The recipient address of the emails"
    toEmails: [String!] @sortable
    "Addresses to cc on emails"
    ccEmails: [String!] @sortable
    "Addresses to bcc on emails"
    bccEmails: [String!] @sortable
    "Owners of the email subscription"
    owners: [String!]! @sortable
    "The cron schedule of the email subscription, formatted in UTC as (Sec, Min, Hour, Day of Month, Month, Day of Week)"
    cronSchedule: String! @sortable
    "The node ids that the email contents are focused on"
    nodeIds: [UUID!] @sortable
    "The object list ids that the email contents are focused on"
    objectListIds: [UUID!] @sortable
    "Audit log events for this email subscription"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this email subscription"
    history (
        "The history filter"
        filter: HistoryFilter
    ): EmailSubscriptionPage!
}

"""
A page of email subscriptions
"""
type EmailSubscriptionPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [EmailSubscription!]!
}

"""
A query for email subscriptions
"""
input EmailSubscriptionQuery {
    "A list of email subscription IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "Email addresses that the subscription 'toEmails' should match"
    toEmails: [String!] @ContainerNotEmpty
    "Email addresses that the subscription 'ccEmails' should match"
    ccEmails: [String!] @ContainerNotEmpty
    "Email addresses that the subscription 'bccEmails' should match"
    bccEmails: [String!] @ContainerNotEmpty
    "Owners that the email subscription owners should match"
    owners: [String!] @ContainerNotEmpty
    "The cron schedules for which to search"
    cronSchedules: [String!]
    "The node ids that the email subscription nodeIds should match"
    nodeIds: [UUID!] @ContainerNotEmpty
    "The object list ids that the email subscription nodeIds should match"
    objectListIds: [UUID!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
The input type for the create email subscription request
"""
input CreateEmailSubscriptionInput {
    "The ACM"
    acm: ACM!
    "The tags"
    tags: [String!] @Size(max: 128)
    "The email subscription  name"
    name: String! @Size(max: 128)
    "The email subscription description"
    description: String! @Size(max: 512)
    "The recipient address of the emails"
    toEmails: [String!] @Size(max: 256)
    "Addresses to cc on emails"
    ccEmails: [String!] @Size(max: 256)
    "Addresses to bcc on emails"
    bccEmails: [String!] @Size(max: 256)
    "Owners of the email subscription"
    owners: [String!] @Size(max: 512)
    "The cron schedule of the email subscription"
    cronSchedule: String! @Size(max: 128)
    "The node ids that the email contents are focused on"
    nodeIds: [UUID!]
    "The object list ids that the email contents are focused on"
    objectListIds: [UUID!]
}

"""
The input type for the update email subscription request
"""
input UpdateEmailSubscriptionInput {
    "The UUID of the email subscription to update"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The email subscription name"
    name: String @Size(max: 128)
    "The email subscription description"
    description: String @Size(max: 512)
    "The Update String List for toEmails"
    toEmails: UpdateEmailList
    "The Update String List for ccEmails"
    ccEmails: UpdateEmailList
    "The Update String List for bccEmails"
    bccEmails: UpdateEmailList
    "The Update String List for owners"
    owners: UpdateUserList
    "A replacement cron schedule"
    cronSchedule: String @Size(max: 128)
    "The Update Id List for Node Ids"
    nodeIds: UpdateUuidList
    "The Update Id List for Object List Ids"
    objectListIds: UpdateUuidList
}

"""
The input type for the update email subscription request
"""
input SyncEmailSubscriptionInput {
    "The UUID of the email subscription to update"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The email subscription name"
    name: String @Size(max: 128)
    "The email subscription description"
    description: String @Size(max: 512)
    "The Update String List for toEmails"
    toEmails: [String!] @Size(max: 256)
    "The Update String List for ccEmails"
    ccEmails: [String!] @Size(max: 256)
    "The Update String List for bccEmails"
    bccEmails: [String!] @Size(max: 256)
    "The Update String List for owners"
    owners: [String!] @Size(max: 512)
    "A replacement cron schedule"
    cronSchedule: String @Size(max: 128)
    "The Update Id List for Node Ids"
    nodeIds: [UUID!]
    "The Update Id List for Object List Ids"
    objectListIds: [UUID!]
}

# ************************************************
# ************** USER METRICS TYPES **************
# ************************************************

"A user metrics entry"
type UserMetric {
    "The user metric ID"
    id: UUID! @sortable
    "The date/time the metric was created"
    timestamp: DateTime! @sortable
    "The user to whom the metric pertains"
    userId: String! @sortable
    "The type of request that was made"
    requestType: RequestType! @sortable
    "The name of request that was made"
    requestNames: [String!] @sortable
    "The latency of request that was made in milliseconds"
    requestLatencyMs: Long! @sortable
    "The status code/error information for the metric"
    statusCodeErrorInfo: String! @sortable
}

"""
A page of user metrics
"""
type UserMetricPage implements Page {
    "The total number of matching user metrics"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM of the data"
    rollupAcm: ACM
    "The data list"
    data: [UserMetric!]!
}

"""
A query for user metrics
"""
input UserMetricQuery {
    "A list of user metric IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "The time query"
    timestamp: TimeQuery
    "A list of users to match"
    userIds: [String!] @ContainerNotEmpty
    "The request type query"
    requestType: RequestTypeQuery
    "The request names query"
    requestNames: RequestNamesQuery
    "The request latency query"
    requestLatencyMs: RequestLatencyQuery
    "The status code/error info query"
    statusCodeErrors: [String!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
A query for the request type enumeration
"""
input RequestTypeQuery {
    "The request type equals this value"
    is: RequestType
    "The request type does not equal this value"
    not: RequestType
    "The request type is one of these value"
    any: [RequestType!] @ContainerNotEmpty
    "The request type is none of these value"
    none: [RequestType!] @ContainerNotEmpty
}

"""
A query for request latency data
"""
input RequestLatencyQuery {
    "The matched latency is greater than this latency in milliseconds"
    gt: Long
    "The matched latency is greater than or equal to this latency in milliseconds"
    gte: Long
    "The matched latency is less than this latency in milliseconds"
    lt: Long
    "The matched latency is less than or equal to this latency in milliseconds"
    lte: Long
    "A null latency should match"
    matchNull: Boolean
}

"""
A query for request names data
"""
input RequestNamesQuery {
    "The matched request names list contains this list of request names"
    contains: [String!] @ContainerNotEmpty
    "The matched request names list does not contain this list of request names"
    notContains: [String!] @ContainerNotEmpty
    "The matched request names list has elements in common with this list of request names"
    overlaps: [String!] @ContainerNotEmpty
}

# ************************************************
# ************ COLLECTION STATUS TYPES ***********
# ************************************************
"""
The type for a given Provider's collection status
"""
type ProviderCollectionStatus {
    "The provider to which this status applies"
    provider: Provider!
    "status of data collection from this provider as enum OK or STALE"
    status: CollectionStatus!
    "latest datetime of collected data from this provider"
    lastDataTime: DateTime
}

"""
The type for a given originator's collection status and all it's tracked providers
"""
type OriginatorCollectionStatus {
    "The rollup ACM"
    rollupAcm: ACM
    "The originator to which this status applies"
    originator: Originator!
    "status of data collection from this originator as enum OK or STALE"
    status: CollectionStatus!
    "latest datetime of collected data from this originator"
    lastDataTime: DateTime
    "list of all providers under the originator and their respective collection statuses"
    providerStatuses: [ProviderCollectionStatus!]!
}

"""
return for a request for a full report of all tracked originator and provider collection statuses
"""
type CollectionStatusReport {
    "The rollup ACM"
    rollupAcm: ACM
    "The originator status list"
    originatorStatuses: [OriginatorCollectionStatus!]!
}

"""
input type for retrieving a provider collection status with the given ID
"""
input ProviderStatusQuery {
    providerId: UUID!
}

"""
input type for retrieving an originator collection status with the given ID
"""
input OriginatorStatusQuery {
    originatorId: UUID!
}

# ************************************************
# *********** OBJECT LIST TYPES ************
# ************************************************

"""
An object list allows users to group objects together in collections.
"""
type ObjectList implements Auditable {
    "The object list ID"
    id: UUID! @sortable
    " The object list version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "Whether the object list is public"
    isPublic: Boolean! @sortable
    "The owners of the object list"
    owners: [String!]! @sortable
    "The groups of the object list"
    groups: [String!] @sortable
    "The name of the object list"
    name: String! @sortable
    "The description of the object list"
    description: String @sortable
    "The node IDs of the object list"
    nodeIds: [UUID!]! @sortable
    "The sub-list IDs of the object list"
    subListIds: [UUID!]! @sortable
    "Is this a JAOL protected object list"
    isJaol: Boolean! @sortable
    "The list of COCOMs which control this JAOL list. List is global if no COCOMs are specified"
    jaolCocoms: [String!] @sortable
    "Audit log events for this object list"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this object list"
    history (
        "The history filter"
        filter: HistoryFilter
    ): ObjectListPage!
    "The resolvable list of object permissions"
    permissions: [Permission!]!
    "The nodes associated with this object list"
    nodes (
        "The node filter"
        filter: NodeFilter
    ): NodePage!
    "The sub-lists associated with this object list"
    subLists: [ObjectList!]!
    "The nodeChanges associated with the nodes in this object list"
    nodeChanges(
        "The node change filter"
        filter: ObjectListNodeChangeFilter
    ): NodeChangePage!
    "The pending updates to this JAOL enabled list"
    pendingUpdates: [PendingJaolUpdate!]!
    "The tickets connected to this object list"
    tickets(
        "The ticket filter"
        filter: ObjectListTicketFilter
    ): TicketPage!
}

"""
A page of object lists
"""
type ObjectListPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [ObjectList!]!
}

"""
A pending JAOL update
"""
type PendingJaolUpdate {
    "The ID of the pending update"
    id: UUID!
    "The ID of the object list to which this update pertains"
    objectListId: UUID!
    "The user who requested the change"
    requestedBy: String!
    "The time at which the change was requested"
    requestedAt: DateTime!
    "The node ID to add"
    addNodeId: UUID
    "The node ID to remove"
    removeNodeId: UUID
}

"""
A query for object lists
"""
input ObjectListQuery {
    "A list of object list IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "Whether the object list is public"
    isPublic: Boolean
    "Whether the collection is editable by the user"
    canEdit: Boolean
    "A list of owners to match"
    owners: [String!] @ContainerNotEmpty
    "A list of groups to match"
    groups: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "A list of node IDs to match"
    nodeIds: [UUID!] @ContainerNotEmpty
    "A list of sub-list IDs to match"
    subListIds: [UUID!] @ContainerNotEmpty
    "Is this a JAOL protected object list"
    isJaol: Boolean
    "A list of COCOMs to match against the JAOL list"
    jaolCocoms: [String!] @ContainerNotEmpty
    "A filter for pending updates"
    hasPendingUpdates: Boolean
    "The page parameters"
    pageParams: PageParams
}

"""
A Sub-graph filter for object list
"""
input ObjectListFilter {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "Whether the object list is public"
    isPublic: Boolean
    "Whether the collection is editable by the user"
    canEdit: Boolean
    "A list of owners to match"
    owners: [String!] @ContainerNotEmpty
    "A list of groups to match"
    groups: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "A list of sub-list IDs to match"
    subListIds: [UUID!] @ContainerNotEmpty
    "Is this a JAOL protected object list"
    isJaol: Boolean
    "A list of COCOMs to match against the JAOL list"
    jaolCocoms: [String!] @ContainerNotEmpty
    "A filter for pending updates"
    hasPendingUpdates: Boolean
    "The page parameters"
    pageParams: PageParams
}

"""
The input type for the create object list request
"""
input CreateObjectListInput {
    "The ACM"
    acm: ACM!
    "The tags"
    tags: [String!] @Size(max: 128)
    "Whether the object list is public"
    isPublic: Boolean! = false
    "The groups of the object list"
    groups: [String!] @Size(max: 128)
    "The name of the object list"
    name: String! @Size(max: 128)
    "The description of the object list"
    description: String @Size(max: 2048)
    "The IDs of the nodes in the object list"
    nodeIds: [UUID!]
    "The IDs of the sub-lists in the object list"
    subListIds: [UUID!]
    "Is this a JAOL protected object list"
    isJaol: Boolean! = false
    "The list of COCOMs which control this JAOL list. List is global if no COCOMs are specified"
    jaolCocoms: [String!]
}

"""
The input type for the update object list request
"""
input UpdateObjectListInput {
    "The ID of the object list to update"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "Whether the object list is public"
    isPublic: Boolean
    "The groups of the object list"
    groups: [String!] @Size(max: 128)
    "The name of the object list"
    name: String @Size(max: 128)
    "The description of the object list"
    description: String @Size(max: 2048)
    "The update id list for node ids"
    nodeIds: UpdateUuidList
    "The IDs of the sub-lists in the object list"
    subListIds: [UUID!]
    "Is this a JAOL protected object list"
    isJaol: Boolean
    "The list of COCOMs which control this JAOL list. List is global if no COCOMs are specified"
    jaolCocoms: [String!]
}

"""
The input type for the sync object list request
"""
input SyncObjectListInput {
    "The ID of the object list to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "Whether the object list is public"
    isPublic: Boolean
    "The owners of the object list"
    owners: [String!] @Size(max: 512)
    "The groups of the object list"
    groups: [String!] @Size(max: 128)
    "The name of the object list"
    name: String @Size(max: 128)
    "The description of the object list"
    description: String @Size(max: 2048)
    "The node IDs of the object list"
    nodeIds: [UUID!]
    "The IDs of the sub-lists in the object list"
    subListIds: [UUID!]
    "Is this a JAOL protected object list"
    isJaol: Boolean
    "The list of COCOMs which control this JAOL list. List is global if no COCOMs are specified"
    jaolCocoms: [String!]
}

"""
The input for adjudicating JAOL object list mutations
"""
input JaolAdjudicationInput {
    "Approve the given queued JAOL updates"
    approve: [UUID!]
    "Deny the given queued JAOL updates"
    deny: [UUID!]
}

# ************************************************
# *************** NODE CHANGE TYPES **************
# ************************************************

"""
A node change event object
"""
type NodeChange {
    "The ID of the node change"
    id: UUID! @sortable
    "The time of the node change"
    timestamp: DateTime! @sortable
    "The user ID who initiated the change"
    userId: String! @sortable
    "The ID of the affected node"
    nodeId: UUID! @sortable
    "The version of the affected node"
    nodeVersion: Long! @sortable
    "The node change type"
    changeType: NodeChangeType! @sortable
    "The type of the related object"
    relatedObjectType: ObjectType @sortable
    "The UUID of the related object"
    relatedObjectId: UUID @sortable
    "The version of the related object"
    relatedObjectVersion: Long @sortable
    "The mutation action of the related action if the change type is OBJECT_CHANGE"
    relatedObjectChangeAction: Action @sortable
    "The referenced node"
    node: Node
    "The related object"
    relatedObject: NodeChangeRelatedObject
}

"""
A page of node change objects
"""
type NodeChangePage implements Page {
    "The total amount of all matching data"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "A rollup ACM for the data list"
    rollupAcm: ACM
    "The data list"
    data: [NodeChange!]!
}

"""
The input object for the nodeChanges endpoint
"""
input NodeChangeQuery {
    "The UUIDs of the change events to match"
    ids: [UUID!] @ContainerNotEmpty
    "The object list ID for which to request node changes"
    objectListId: UUID
    "The timestamp query"
    timestamp: TimeQuery
    "A list of user IDs to match"
    userIds: [String!] @ContainerNotEmpty
    "A list of node IDs to match"
    nodeIds: [UUID!] @ContainerNotEmpty
    "A change type query"
    changeType: NodeChangeTypeQuery
    "A related object type query"
    relatedObjectType: ObjectTypeQuery
    "The related object IDs to match"
    relatedObjectIds: [UUID!] @ContainerNotEmpty
    "A related object mutation action query"
    relatedObjectChangeAction: ActionQuery
    "The page parameters"
    pageParams: PageParams
}

"""
A node change filter for node sub-graph traversals
"""
input NodeNodeChangeFilter {
    "The object list ID for which to request node changes"
    objectListId: UUID
    "The timestamp query"
    timestamp: TimeQuery
    "A list of user IDs to match"
    userIds: [String!] @ContainerNotEmpty
    "A change type query"
    changeType: NodeChangeTypeQuery
    "A related object type query"
    relatedObjectType: ObjectTypeQuery
    "The related object IDs to match"
    relatedObjectIds: [UUID!] @ContainerNotEmpty
    "A related object mutation action query"
    relatedObjectChangeAction: ActionQuery
    "The page parameters"
    pageParams: PageParams
}

"""
A sub-graph filter for node change objects
"""
input ObjectListNodeChangeFilter {
    "The timestamp query"
    timestamp: TimeQuery
    "A list of user IDs to match"
    userIds: [String!] @ContainerNotEmpty
    "A list of node IDs to match"
    nodeIds: [UUID!] @ContainerNotEmpty
    "A change type query"
    changeType: NodeChangeTypeQuery
    "A related object type query"
    relatedObjectType: ObjectTypeQuery
    "The related object IDs to match"
    relatedObjectIds: [UUID!] @ContainerNotEmpty
    "A related object mutation action query"
    relatedObjectChangeAction: ActionQuery
    "The page parameters"
    pageParams: PageParams
}

"""
A node change type query
"""
input NodeChangeTypeQuery {
    "The action equals this value"
    is: NodeChangeType
    "The action does not equal this value"
    not: NodeChangeType
    "The action is one of these value"
    any: [NodeChangeType!] @ContainerNotEmpty
    "The action is none of these value"
    none: [NodeChangeType!] @ContainerNotEmpty
}

# ************************************************
# *********** USER PREFERENCE TYPES **************
# ************************************************

"""
User preferences of a specific user stored in JSON
"""
type UserPreferences implements Auditable @uniqueOn(fields: ["userId", "appId"]){
    "The user preferences ID"
    id: UUID! @sortable
    "The user preferences version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The ID of associated user"
    userId: String! @sortable
    "The ID of associated app"
    appId: String! @sortable
    "The preferences JSON blob"
    preferences: Preferences!
    "Audit log events for this user preferences object"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this user preferences object"
    history (
        "The history filter"
        filter: HistoryFilter
    ): UserPreferencesPage!
}

"""
A page of user preferences
"""
type UserPreferencesPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [UserPreferences!]!
}

"""
Input object to get user preferences
"""
