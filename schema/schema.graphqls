    "The ACM"
    acm: ACM!
    "The ID of associated app"
    appId: String! @Size(max: 128)
    "The preferences "
    preferences: Preferences!
}

"""
Input to update an existing user preferences object
"""
input UpdateUserPreferencesInput {
