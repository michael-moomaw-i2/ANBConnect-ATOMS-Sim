    ids: [UUID!]
    "A list of tags to match"
    tags: [String!]
    "A list of target object IDs to match"
    targetObjectIds: [UUID!]
    "An object type match query"
    targetObjectType: ObjectTypeQuery
    "A list of source IDs to match"
    sourceIds: [UUID!]
    "A confidence query"
    confidence: ConfidenceQuery
    "Likelihood value to match"
    likelihood: LikelihoodQuery
    "A list of assessment owners to match"
    owner: [String!]
    "A query for the time of assessment"
    timeOfAssessment: TimeQuery
    "A content type match query"
    contentType: StringQuery
    "A content body match query"
    contentBody: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
An assessment filter for source sub-graph traversals
"""
input SourceAssessmentFilter {
    "A list of tags to match"
    tags: [String!]
    "A list of target object IDs to match"
    targetObjectIds: [UUID!]
    "An object type match query"
    targetObjectType: ObjectTypeQuery
    "A confidence query"
    confidence: ConfidenceQuery
    "Likelihood value to match"
    likelihood: LikelihoodQuery
    "A list of assessment owners to match"
    owner: [String!]
    "A query for the time of assessment"
    timeOfAssessment: TimeQuery
    "A content type match query"
    contentType: StringQuery
    "A content body match query"
    contentBody: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
A sub-graph filter for assessment objects
"""
input AssessmentFilter {
    "A list of tags to match"
    tags: [String!]
    "A list of source IDs to match"
    sourceIds: [UUID!]
    "A confidence query"
    confidence: ConfidenceQuery
    "Likelihood value to match"
    likelihood: LikelihoodQuery
    "A list of assessment owners to match"
    owner: [String!]
    "A query for the time of assessment"
    timeOfAssessment: TimeQuery
    "A content type match query"
    contentType: StringQuery
    "A content body match query"
    contentBody: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
The input type for the create assessment request
"""
input CreateAssessmentInput {
    "The ACM"
    acm: ACM!
    "The tags"
    tags: [String!] @Size(max: 128)
    "The ID of the object upon which this assessment belongs"
    targetObjectId: UUID!
    "The type of the object upon which this assessment belongs"
    targetObjectType: ObjectType!
    "The list of associated source IDs"
    sourceId: UUID!
    "The assessment content type"
    contentType: String! = "text" @Size(max: 128)
    "The assessment content body"
    contentBody: String! @Size(max: 2048)
    "The confidence"
