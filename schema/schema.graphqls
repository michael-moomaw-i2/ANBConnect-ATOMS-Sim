"""
The input type for verify requests
"""
input VerifyInput {
    "The ID of the object to verify"
    id: UUID!
}

# ************************************************
# ***************** ENUMERATIONS *****************
# ************************************************

"""The authority values for attributes and objects"""
enum AuthorityValue {
    "This user has full authority over the object"
    DIAP,
    "This user has been designated Subject Matter Expert authority for the object"
    SME,
    "This user does not specifically have authority for the object, but is a trusted user from a different COCOM"
    DIAAE,
    "This user does not have authority in any COCOM"
    NON_DIAAE,
    "This user has no authority at all"
    NON_AUTHORITATIVE
}

"CRUD Permission values"
enum Permission {
    CREATE,
    READ,
    UPDATE,
    DELETE,
    REVIEW
}

"The sort directions"
enum SortDirection {
    ASC,
    DESC,
    DESC_NULLS_LAST
}

"""
The audit action values
"""
enum Action {
    CREATE,
    UPDATE,
    DELETE,
    RESTORE,
    VERIFY,
    MERGE_SOURCE,
    MERGE_TARGET
}

"""
The complex audit event type
"""
enum ComplexEventType {
    NODE_MERGE
}

"The object types"
enum ObjectType {
    ORIGINATOR
    PROVIDER
    SOURCE
    ATTRIBUTE
    OBSERVATION
    ACTIVITY
    RELATIONSHIP
    NODE
    COMMENT
    NOTIFICATION
    OBJECT_LIST
    USER_PREFERENCES
    BASEBALL_CARD
    EMAIL_SUBSCRIPTION
    ASSESSMENT
    ALERT_SUBSCRIPTION
    TICKET
    PROJECT
}

"An enumeration for how confident the data is"
enum Confidence {
    UNKNOWN
    LOW
    MODERATE
    HIGH
}

"The Tier of the object- whether it is directly from a source or derived from other information"
enum ObjectTier {
    PRIMARY
    DERIVATIVE
    CONTRIBUTED
    UNESTABLISHED
    UNKNOWN
}

"An enumeration for what domain ... is"
enum Domain {
    UNKNOWN
    ANY
    GROUND
    SEA_SURFACE
    SEA_SUBSURFACE
    AIR
    CYBER
    SPACE
}

"""
The directionality of the relationship.

Ex for has_allegiance_to:
INCOMING: THAT object has allegiance to THIS object
OUTGOING: THIS object has allegiance to THAT object
BOTH: These objects have allegiance to each other
"""
enum RelationshipDirection {
    INCOMING
    OUTGOING
    BOTH
}

"""
The notification severity levels
"""
enum Severity {
    "General information that should not impact system operations"
    INFORMATIONAL
    "Warnings that may impact the system but allow the system operations to continue in a potentially degraded state"
    WARNING
    "Critical information that may prevent the system from operating normally"
    CRITICAL
}

"""
The fields on a Node
"""
enum NodeField {
    TAGS
    LABELS
    NAME
    TIER
    DOMAIN
    CLASS_IRI
    SYMBOL_ID_CODE
    IFC_CODES
    ALLEGIANCE
    IS_NSO
    TRACK_PROVIDER_ID
}

"""
The request types
"""
enum RequestType {
    "A request that reads an object"
    QUERY
    "A request that creates, updates, or deletes an object"
    MUTATION
    "A request that opens a connection for a stream of objects"
    SUBSCRIPTION
}

"""
The attribute value types
"""
enum AttributeType {
    "A boolean value of either 'true' or 'false'"
    BOOLEAN
    "A sting value"
    STRING
    "A number value"
    NUMBER
    "An ISO 8601 compliant timestamp"
    TIMESTAMP
    "An arbitrary object"
    OBJECT
    "A geospatial location"
    GEOSPATIAL
    "An image"
    IMAGE
}

"""
The geo query type
"""
enum GeoQueryType {
    "The query GeoJson intersects the stored geometry"
    INTERSECTS
    "The query GeoJson does not intersect the stored geometry"
    DISJOINT
}

"""
The collection statuses
"""
enum CollectionStatus {
    "Objects pulled for an originator or provider meet the threshold date for healthy status"
    OK
    "None of the objects delivered back from the provider or originator have been returned by the threshold date for healthy"
    STALE
}

"""
The node change type
"""
enum NodeChangeType {
    "The node was created"
    CREATE
    "The node was updated"
    UPDATE
    "The node was deleted"
    DELETE
    "The node was restored"
    RESTORE
    "The node was verified"
    VERIFY
    "The node was merged into another node"
    MERGE_SOURCE
    "Another node was merged into this node"
    MERGE_TARGET
    "A related object was gained"
    RELATED_OBJECT_GAIN
    "A related object was changed in some way"
    RELATED_OBJECT_CHANGE
    "A related object was lost"
    RELATED_OBJECT_LOSS
}

"""
The source type
"""
enum SourceType {
    "Comes from a single source"
    SINGLE_SOURCE,
    "Comes from all sources"
    ALL_SOURCE
}

"""
The custody category
"""
enum CustodyCategory {
    UNKNOWN
    GREEN
    YELLOW
    RED
}

"""
The ticket type
"""
enum TicketType {
    TASK
}

"""
The ticket status
"""
enum TicketStatus {
    OPEN
    CLOSED
}

# ************************************************
# ************************************************
# ************************************************
