    name: StringQuery
    "The URL match query"
    url: StringQuery
    "A description match query"
    description: StringQuery
    "A list of originator IDs to match"
    originatorIds: [UUID!] @ContainerNotEmpty
    "The page parameters"
    pageParams: PageParams
}

"""
