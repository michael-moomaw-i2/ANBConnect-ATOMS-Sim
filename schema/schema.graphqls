    # ******************* GROUPS *********************
    # ************************************************

    "Get the ATOMS groups"
    groups: [OmsGroup!]!

    # ************************************************
    # ****************** USER METRICS ****************
    # ************************************************

    "Get the user metrics with the given ID"
    userMetric(query: IdQuery!): UserMetric

    "Get the user metrics that match the given query"
    userMetrics(query: UserMetricQuery!): UserMetricPage!

