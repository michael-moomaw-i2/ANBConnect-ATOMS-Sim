# ************************************************
# ****************** NODE TYPES ******************
# ************************************************
"""
Holds data about an object in the graph, this is the core object that handles relationships with other objects
"""
type Node implements Auditable & Verifiable {
    "The node ID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The labels"
    labels: [String!] @sortable
    "The EOID"
    eoid: String @sortable
    "The EOID history"
    eoidHistory: [String!] @sortable
    "The GUIDE ID"
    guideId: String @sortable
    "The GUIDE ID history"
    guideIdHistory: [String!] @sortable
    "The node name"
    name: String! @sortable
    "The object tier"
    tier: ObjectTier! @sortable
    "The domain of this node"
    domain: Domain! @sortable
    "The class IRI"
    classIri: String! @sortable
    "The class name"
    className: String! @sortable
    "The symbol Id code"
    symbolIdCode: String @sortable
    "The object IFC codes"
    ifcCodes: [String!] @sortable
    "The object allegiance"
    allegiance: String @sortable
    "The allegiance AOR"
    allegianceAor: String @sortable
    "The current AOR based on latest location"
    currentAor: String @sortable
    "The NSO flag"
    isNso: Boolean! @sortable
    "The ID of the preferred track provider if there is one"
    trackProviderId: UUID @sortable
    "Audit log events for this node"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this node"
    history (
        "The history filter"
        filter: HistoryFilter
    ): NodePage!
    "The attributes associated with this node"
    attributes (
        "The attribute filter"
        filter: AttributeFilter
    ): AttributePage!
    "The observations associated with this node"
    observations (
        "The observation filter"
        filter: NodeObservationFilter
    ): ObservationPage!
    "Activities that are related to this node"
    activities (
        "The activity filter"
        filter: NodeActivityFilter
    ): ActivityPage!
    assessments (
        "The assessment filter"
        filter: AssessmentFilter
    ): AssessmentPage!
    "The relationships associated with this node"
    relationships (
        "The relationship filter"
        filter: NodeRelationshipFilter
    ): RelationshipPage!
    "The object lists associated with this node"
    objectLists (
        "The object list filter"
        filter: ObjectListFilter
    ): ObjectListPage!
    "The comments associated with this node"
    comments (
        "The comment filter"
        filter: CommentFilter
    ): CommentPage!
    "The resolvable ontology class"
    ontologyClass: OntologyClass
    "The changes to the node"
    nodeChanges(
        "The node change filter"
        filter: NodeNodeChangeFilter
    ): NodeChangePage!
    "The resolvable list of object permissions"
    permissions: [Permission!]!
    "The latest known location of this node"
    latestKnownLocation(
        "The preferred provider query"
        filter: PreferredProviderFilter
    ): Observation @sortable #NOTE: as a special exception, this field is sortable under the key "latest_location"
    "The most recent object verification"
    lastVerified: Verification!
    "The custody status of this node"
    custodyStatus: CustodyStatus!
    "The track provider for this node"
    trackProvider: Provider
    "The tickets connected to this node"
    tickets(
        "The ticket filter"
        filter: NodeTicketFilter
    ): TicketPage!
}

"""
A page of nodes
"""
type NodePage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Node!]!
}

"""
A query for node objects
"""
input NodeQuery {
    "A list of node IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "EOIDs to match"
    eoids: [String!] @ContainerNotEmpty
    "A guide IDs to match"
    guideIds: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A tier match query"
    tier: ObjectTierQuery
    "A query for the domain of a node"
    domain: DomainQuery
    "A list of class IRIs to match"
    classIris: [String!] @ContainerNotEmpty
    "A class name match query"
    className: StringQuery
    "A list of Symbol Id Codes to match"
    symbolIdCodes: [String!] @ContainerNotEmpty
    "A list of allegiances to match"
    allegiances: [String!] @ContainerNotEmpty
