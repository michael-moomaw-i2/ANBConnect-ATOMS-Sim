"""
A query for the attribute type enumeration
"""
input AttributeTypeQuery {
    "The attribute type equals this value"
    is: AttributeType
    "The attribute type does not equal this value"
    not: AttributeType
    "The attribute type is one of these value"
    any: [AttributeType!] @ContainerNotEmpty
    "The attribute type is none of these value"
    none: [AttributeType!] @ContainerNotEmpty
}

"A type that describes a user's role in a specific COCOM"
type UserRole {
    "The cocom this role applies to. This can be n/a, meaning it does not correlate to a specific cocom."
    aor: String!
    "The user's role"
    role: String!
}

"A type that describes an ATOMS group"
type OmsGroup {
    "The name of the group"
    name: String!
    "The group"
    group: String!
}

"The input type for the create attribute request"
input CreateAttributeInput {
    "The attribute IRI"
    attributeIri: String! @Size(max: 512)
    "The attribute value"
    attributeValue: String! @Size(max: 2048)
    "The attribute display value"
    attributeDisplayValue: String @Size(max: 2048)
    "The attribute normalized value"
    attributeNormalizedValue: String @Size(max: 2048)
    "The attribute type"
    attributeType: AttributeType!
    "The GeoJSON geometry if this is a geospatial type"
    geometry: GeoJSON
    "The confidence"
    confidence: Confidence!
    "The source type"
    sourceType: SourceType
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The source ID"
    sourceId: UUID!
    "The node ID"
    nodeId: UUID
    "The observation ID"
    observationId: UUID
    "The activity ID"
    activityId: UUID
    "The ACM"
    acm: ACM!
    "The effective value start time"
    valueStart: DateTime,
    "The effective value end time"
    valueEnd: DateTime
    "A flag to specify if an attribute may be modified by a user"
    isMutable: Boolean! = true
    "Is this attribute reviewed by the requesting user"
    isReviewed: Boolean
    "The authoritative flag"
    isAuthoritative: Boolean! = false
    "The isUserEntered flag"
    isUserEntered: Boolean! = false
    "The maximum authority value"
    authorityValue: AuthorityValue
}

"The input type for the update attribute request"
input UpdateAttributeInput {
    "The ID of the attribute to update"
    id: UUID!
    "The attribute IRI"
    attributeIri: String @Size(max: 512)
    "The attribute value"
    attributeValue: String @Size(max: 2048)
    "The attribute display value"
    attributeDisplayValue: String @Size(max: 2048)
    "The attribute normalized value"
    attributeNormalizedValue: String @Size(max: 2048)
    "The attribute type"
    attributeType: AttributeType
    "The GeoJSON geometry if this is a geospatial type"
    geometry: GeoJSON
    "The confidence"
    confidence: Confidence
    "The source type"
    sourceType: SourceType
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The source ID"
    sourceId: UUID
    "The node ID"
    nodeId: UUID
    "The observation ID"
    observationId: UUID
    "The activity ID"
    activityId: UUID
    "The ACM"
    acm: ACM
    "The effective value start time"
    valueStart: DateTime
    "The effective value end time"
    valueEnd: DateTime
    "A flag to specify if an attribute may be modified by a user"
    isMutable: Boolean
    "Is this attribute reviewed by the requesting user"
    isReviewed: Boolean
    "The authoritative flag"
    isAuthoritative: Boolean
    "The isUserEntered flag"
    isUserEntered: Boolean
    "The maximum authority value"
    authorityValue: AuthorityValue
}

"The input type for the sync attribute request"
input SyncAttributeInput {
    "The ID of the attribute to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The attribute IRI"
    attributeIri: String @Size(max: 512)
    "The attribute value"
    attributeValue: String @Size(max: 2048)
    "The attribute display value"
    attributeDisplayValue: String @Size(max: 2048)
    "The attribute normalized value"
    attributeNormalizedValue: String @Size(max: 2048)
    "The attribute type"
    attributeType: AttributeType
    "The GeoJSON geometry if this is a geospatial type"
    geometry: GeoJSON
    "The confidence"
    confidence: Confidence
    "The source ID"
    sourceId: UUID
    "The source type"
    sourceType: SourceType
    "The node ID"
    nodeId: UUID
    "The observation ID"
    observationId: UUID
    "The activity ID"
    activityId: UUID
    "The maximum authority value"
    authorityValue: AuthorityValue
    "The user who set the current authority value"
    authoritySetBy: String @Size(max: 512)
    "The time at which the authority value was set"
    authoritySetAtTime: DateTime
    "The effective value start time"
    valueStart: DateTime
    "The effective value end time"
    valueEnd: DateTime
    "A flag to specify if an attribute may be modified by a user"
    isMutable: Boolean
    "The authoritative flag"
    isAuthoritative: Boolean
    "The isUserEntered flag"
    isUserEntered: Boolean
    "Is this attribute reviewed by the requesting user"
    isReviewed: Boolean
    "The user who reviewed the attribute"
    reviewedBy: String @Size(max: 512)
    "The time at which the attribute was reviewed"
    reviewedAt: DateTime
}

# ************************************************
# ************** RELATIONSHIP TYPES **************
# ************************************************

"""
A relationship between two nodes
"""
type Relationship implements Auditable & Verifiable {
    "The ID of the relationship"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The acm for the relationship"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The labels"
    labels: [String!] @sortable
    "The name of the relationship"
    name: String! @sortable
    "The start node"
    startNodeId: UUID! @sortable
    "The end node"
    endNodeId: UUID! @sortable
    "The confidence"
    confidence: Confidence! @sortable
    "The type of relationship pulled from the ontology"
    objectPropertyIri: String! @sortable
    "The name of the relationship type"
    objectPropertyName: String! @sortable
    "The ID of the source of the relationship"
    sourceId: UUID! @sortable
    "The start time"
    startTime: DateTime! @sortable
    "The end time"
    endTime: DateTime! @sortable
    "Audit log events for this relationship"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this relationship"
    history (
        "The history filter"
        filter: HistoryFilter
    ): RelationshipPage!
    "The resolvable start node object"
    startNode: Node
    "The resolvable end node object"
    endNode: Node
    "The resolvable source object"
    source: Source
    "The comments associated with this relationship"
    comments (
        "The comment filter"
        filter: CommentFilter
    ): CommentPage!
    assessments (
        "The assessment filter"
        filter: AssessmentFilter
    ): AssessmentPage!
    "The ontology relationship"
    ontologyRelationship: OntologyRelationship
    "The most recent object verification"
    lastVerified: Verification!
}

"""
A page of relationships
"""
type RelationshipPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Relationship!]!
}

"""
A query for relationship objects
"""
input RelationshipQuery {
    "A list of relationship IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "The relationship node query"
    nodes: RelationshipNodeQuery
    "A confidence match query"
    confidence: ConfidenceQuery
    "A list of source IDs to match"
    sourceIds: [UUID!] @ContainerNotEmpty
    "A object property iri match string"
    objectPropertyIris: [String!] @ContainerNotEmpty
    "A object property name match query"
    objectPropertyName: StringQuery
    "A query for the data start time"
    startTime: TimeQuery
    "A query for the data end time"
    endTime: TimeQuery
    "The page parameters"
    pageParams: PageParams
}

"""
A source Sub-graph filter for relationship objects
"""
input SourceRelationshipFilter {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "The relationship node query"
    nodes: RelationshipNodeQuery
    "A confidence match query"
    confidence: ConfidenceQuery
    "A object property iri match string"
    objectPropertyIris: [String!] @ContainerNotEmpty
    "A object property name match query"
    objectPropertyName: StringQuery
    "A query for the data start time"
    startTime: TimeQuery
    "A query for the data end time"
    endTime: TimeQuery
    "The page parameters"
    pageParams: PageParams
}

"""
The relationship node query input
"""
input RelationshipNodeQuery {
    "A list of ID's as either start or end nodes"
    nodeIds: [UUID!] @ContainerNotEmpty
    "A list of start node IDs"
    startNodeIds: [UUID!] @ContainerNotEmpty
    "A list of end node IDs"
    endNodeIds: [UUID!] @ContainerNotEmpty
    "A list of related node ID queries"
    relatedNodeIds: [RelatedNodeIds!] @ContainerNotEmpty
    "A list of related node queries"
    relatedNodes: [RelatedNodes!] @ContainerNotEmpty
}

"""
A pair of related node IDs
"""
input RelatedNodeIds {
    "The relationship direction"
    direction: RelationshipDirection! = BOTH
    "The first node ID"
    firstNodeId: UUID!
    "The second node ID"
    secondNodeId: UUID!
}

"""
A query for related nodes
"""
input RelatedNodes {
    "The relationship direction"
    direction: RelationshipDirection! = BOTH
    "The first node query"
    firstNode: NodeSubQuery!
    "The second node query"
    secondNode: NodeSubQuery!
}

"""
The input type for the create relationship request
"""
input CreateRelationshipInput {
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The name of the relationship"
    name: String! @Size(max: 512)
    "The start node"
    startNodeId: UUID!
    "The end node"
    endNodeId: UUID!
    "Source of this relationship"
    sourceId: UUID!
    "The confidence"
    confidence: Confidence!
    "The ACM"
    acm: ACM!
    "The type of relationship pulled from the ontology"
    objectPropertyIri: String! @Size(max: 512)
    "The start time"
    startTime: DateTime
    "The end time"
    endTime: DateTime
}

"""
The input type for the update relationship request
"""
input UpdateRelationshipInput {
    "The ID of the relationship to update"
    id: UUID!
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The name of the relationship"
    name: String @Size(max: 512)
    "The source of the relationship"
    sourceId: UUID
    "The confidence"
    confidence: Confidence
    "The ACM"
    acm: ACM
    "The type of relationship pulled from the ontology"
    objectPropertyIri: String @Size(max: 512)
    "The start time"
    startTime: DateTime
    "The end time"
    endTime: DateTime
}

"""
The input type for the sync relationship request
"""
input SyncRelationshipInput {
    "The ID of the relationship to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The name of the relationship"
    name: String @Size(max: 512)
    "The ID of the start node"
    startNodeId: UUID
    "The ID of the end node"
    endNodeId: UUID
    "The confidence"
    confidence: Confidence
    "The type of relationship pulled from the ontology"
    objectPropertyIri: String @Size(max: 512)
    "The source of the relationship"
    sourceId: UUID
    "The start time"
    startTime: DateTime
    "The end time"
    endTime: DateTime
}

# ************************************************
# ***************** COMMENT TYPES ****************
# ************************************************

"""
Comments allow analysts to add insight to an object without actually adding an attribute

They can also be used if a user doesn't have the authority required to update an object to still make contributions
"""
type Comment implements Auditable {
    "The comment ID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The ID of the object upon which this comment belongs"
    targetObjectId: UUID! @sortable
    "The type of the object upon which this comment belongs"
    targetObjectType: ObjectType! @sortable
    "The user who made the comment"
    owner: String! @sortable
    "The time at which the comment was made"
    timeOfComment: DateTime! @sortable
    "The comment content type"
    contentType: String! @sortable
    "The comment content body"
    contentBody: String! @sortable
    "Audit log events for this comment"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this comment"
    history (
        "The history filter"
        filter: HistoryFilter
    ): CommentPage!
    "The resolvable target object"
    targetObject: CommentObject
}

"""
A page of comments
"""
type CommentPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Comment!]!
}

"""
A query for comment objects
"""
input CommentQuery {
    "A list of comment IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of target object IDs to match"
    targetObjectIds: [UUID!] @ContainerNotEmpty
    "An object type match query"
    targetObjectType: ObjectTypeQuery
    "A list of comment owners to match"
    owner: [String!] @ContainerNotEmpty
    "A query for the time of comment"
    timeOfComment: TimeQuery
    "A content type match query"
    contentType: StringQuery
    "A content body match query"
    contentBody: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
A sub-graph filter for comment objects
"""
input CommentFilter {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of comment owners to match"
    owner: [String!] @ContainerNotEmpty
    "A query for the time of comment"
    timeOfComment: TimeQuery
    "A content type match query"
    contentType: StringQuery
    "A content body match query"
    contentBody: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
The input type for the create comment request
"""
input CreateCommentInput {
    "The ACM"
    acm: ACM!
    "The tags"
    tags: [String!] @Size(max: 128)
    "The ID of the object upon which this comment belongs"
    targetObjectId: UUID!
    "The type of the object upon which this comment belongs"
    targetObjectType: ObjectType!
    "The comment content type"
    contentType: String! = "text" @Size(max: 128)
    "The comment content body"
    contentBody: String! @Size(max: 2048)
}

"""
The input type for the update comment request
"""
input UpdateCommentInput {
    "The ID of the comment to update"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The comment content type"
    contentType: String @Size(max: 128)
    "The comment content body"
    contentBody: String @Size(max: 2048)
}

"""
The input type for the sync comment request
"""
input SyncCommentInput {
    "The ID of the comment to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The target object ID"
    targetObjectId: UUID
    "The target object type"
    targetObjectType: ObjectType
    "The owner of this comment"
    owner: String @Size(max: 128)
    "The time at which this comment was made"
    timeOfComment: DateTime
    "The comment content type"
    contentType: String @Size(max: 128)
    "The comment content body"
    contentBody: String @Size(max: 2048)
}

# ************************************************
# ************* ASSESSMENT TYPES *****************
# ************************************************
"""
Assessment schema type
"""
type Assessment implements Auditable {
    "The assessment ID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The ID of the object upon which this assessment belongs"
    targetObjectId: UUID! @sortable
    "The type of the object upon which this assessment belongs"
    targetObjectType: ObjectType! @sortable
    "Associated source ID"
    sourceId: UUID! @sortable
    "The user who created the assessment"
    owner: String! @sortable
    "The time at which the assessment was made"
    timeOfAssessment: DateTime! @sortable
    "The assessment content type"
    contentType: String! @sortable
    "The assessment content body"
    contentBody: String! @sortable
    "The assessment confidence"
    confidence: Confidence! @sortable
    "The assessment likelihood"
    likelihood: Float! @Range(min: 0.0, max: 1.0)
    "Audit log events for this comment"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this comment"
    history (
        "The history filter"
        filter: HistoryFilter
    ): AssessmentPage!
    "The comments associated with this assessment"
    comments (
        "The comment filter"
        filter: CommentFilter
    ): CommentPage!
    "The source object"
    source: Source
    "The resolvable target object"
    targetObject: AssessmentObject
}

"""
A page of assessments
"""
type AssessmentPage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Assessment!]!
}

"""
A query for assessment objects
"""
