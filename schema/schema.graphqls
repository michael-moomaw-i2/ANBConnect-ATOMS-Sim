    "The tags"
    tags: [String!] @Size(max: 128)
    "The user preferences JSON blob to update"
    preferences: Preferences
}

# ************************************************
# ************* BASEBALL CARD TYPES **************
# ************************************************

"""
A baseball card that describes which attributes should be applied to which nodes
"""
type BaseballCard implements Auditable @uniqueOn(fields: ["name", "classIri"]) {
    "The baseball card ID"
    id: UUID! @sortable
    "The baseball card version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The view name which can be DEFAULT, a COCOM, or a custom user name"
    name: String! @sortable
    "The class IRI to which this baseball card applies"
    classIri: String! @sortable
    "The class name"
    className: String! @sortable
    "The list of attribute IRIs in this view"
    attributeIris: [String!]! @sortable
    "The list of relationship IRIs in this view"
    relationshipIris: [String!]! @sortable
    "Audit log events for this baseball card object"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this baseball card object"
    history (
        "The history filter"
        filter: HistoryFilter
    ): BaseballCardPage!
    "The full ontology class"
    ontologyClass: OntologyClass!
    "The list of full ontology attributes"
    ontologyAttributes: [OntologyAttribute!]!
    "The list of full ontology relationships"
    ontologyRelationships: [OntologyRelationship!]!
}

