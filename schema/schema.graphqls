}

# ************************************************
# ********** COLLECTION LATENCY Types ************
# ************************************************

"""
The complete latency statistics (entire window of time and each bin)
"""
type CollectionLatencyStats {
    "The latency statistics of the entire window of time"
    overallStats: LatencyStats!
    "The collection of latency statistics for each bin"
    binStats: [LatencyBinStats!]!
}

"""
The latency statistics of a window of time (entire or for a bin)
"""
type LatencyStats {
    "The start time of a specific window of time (entire or for a bin)"
    startTime: DateTime!
    "The end time of a specific window of time (entire or for a bin)"
    endTime: DateTime!
    "The smallest delta (seconds) of date of creation minus date of report of all relevant sources"
    minDorSeconds: Int!
    "The largest delta (seconds) of date of creation minus date of report of all relevant sources"
    maxDorSeconds: Int!
    "The arithmetic mean of all date of report deltas of all relevant sources"
    meanDorSeconds: Int!
    "The arithmetic median of all date of report deltas of all relevant sources"
    medianDorSeconds: Int!
    "The smallest delta (seconds) of date of creation minus date of information of all relevant sources"
    minDoiSeconds: Int!
    "The largest delta (seconds) of date of creation minus date of information of all relevant sources"
    maxDoiSeconds: Int!
    "The arithmetic mean of all date of information deltas of all relevant sources"
    meanDoiSeconds: Int!
    "The arithmetic median of all date of information deltas of all relevant sources"
    medianDoiSeconds: Int!
}

"""
A Latency Statistics for a specific bin
"""
type LatencyBinStats {
    "The bin identifier"
    bin: Int!
    "The latency statistics of this bin"
    stats: LatencyStats!
}

"""
The input type for collection latency
"""
input CollectionLatencyStatsQuery {
    "The number of hours back in time to query"
    lastNHours: Int! = 8 @Min(value: 0) @Max(value: 744)
    "An optional number of bins"
    maxStatsBins: Int! = 10 @Min(value: 0) @Max(value: 30)
    "An optional list of provider IDs for filtering results"
    providerIds: [UUID!] @ContainerNotEmpty
}

