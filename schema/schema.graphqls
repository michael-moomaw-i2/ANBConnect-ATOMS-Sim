    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The class IRI for this observation"
    classIri: String @Size(max: 512)
    "The original user input value prior to GeoJSON conversion (e.g. MGRS)"
    displayValue: String  @Size(max: 2048)
    "The confidence"
    confidence: Confidence
    "The source ID"
    sourceId: UUID
    "The node ID"
    nodeId: UUID
    "The GeoJSON geometry"
    geometry: GeoJSON
    "The start time"
    startTime: DateTime
    "The end time"
    endTime: DateTime
}

"""
The input type for syncing Observation objects
"""
input SyncObservationInput {
    "The ID of the observation to sync"
    id: UUID!
    "The ACM"
    acm: ACM
    "The tags"
    tags: [String!] @Size(max: 128)
    "The labels"
    labels: [String!] @Size(max: 128)
    "The class IRI for this observation"
    classIri: String @Size(max: 512)
    "The original user input value prior to GeoJSON conversion (e.g. MGRS)"
    displayValue: String  @Size(max: 2048)
    "The confidence"
    confidence: Confidence
    "The source ID"
    sourceId: UUID
    "The node ID"
    nodeId: UUID
    "The GeoJSON geometry"
    geometry: GeoJSON
    "The start time"
    startTime: DateTime
    "The end time"
    endTime: DateTime
}

"""
A query input for observations
"""
input ObservationQuery {
    "A list of observation IDs"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "A string query for the iri by a list of iris"
    classIris: StringQueryByList
    "A string query for the class name"
    className: StringQuery
    "A string query for display value"
    displayValue: StringQuery
    "A confidence query"
    confidence: ConfidenceQuery
    "A list of source IDs"
    sourceIds: [UUID!] @ContainerNotEmpty
    "A UUID query for the nodeId by a list of UUIDs"
    nodeIds: UuidQueryByList
    "A geo query"
    geometry: GeoQuery
    "A query for the data start time"
    startTime: TimeQuery
    "A query for the data end time"
    endTime: TimeQuery
    "A list of activity IDs"
    activityIds: [UUID!] @ContainerNotEmpty
    "Whether the observation is included in any activity"
    isPartOfActivity: Boolean
    "A source sub query"
    sources: ObservationSourceSubQuery
    "A node sub query"
    nodes: ObservationNodeSubQuery
    "An activity sub query"
    activities: ObservationActivitySubQuery
    "The page parameters"
    pageParams: PageParams
}

"A sub-query for matching against sources"
input ObservationSourceSubQuery {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A description match query"
    description: StringQuery
    "A date of report time query"
    dateOfReport: TimeQuery
    "A date of information time query"
    dateOfInformation: TimeQuery
    "A creation date time query"
    dateOfCreation: TimeQuery
    "A string query for the primary topic"
    primaryTopic: StringQuery
    "A string query for the secondary topic"
    secondaryTopic: StringQuery
    "A list of provider IDs to match"
    providerIds: [UUID!] @ContainerNotEmpty
    "A list of identifiers to match"
    identifiers: [String!] @ContainerNotEmpty
    "A URI match query"
    uri: StringQuery
    "Search for a string match in either the name, identifier, or uri field"
    text: StringQuery
    "A provider subquery"
    providers: SourceProviderSubQuery
}

"A sub-query for matching against sources"
input ObservationNodeSubQuery {
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "EOIDs to match"
    eoids: [String!] @ContainerNotEmpty
    "A guide IDs to match"
    guideIds: [String!] @ContainerNotEmpty
    "A name match query"
    name: StringQuery
    "A tier match query"
