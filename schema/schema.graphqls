# ************************************************
# **************** ATTRIBUTE TYPES ***************
# ************************************************

"""
An attribute describes a node or source
"""
type Attribute implements Auditable & Verifiable {
    "The attribute ID"
    id: UUID! @sortable
    "The object version"
    version: Long! @sortable
    "The ACM"
    acm: ACM! @sortable
    "The tags"
    tags: [String!] @sortable
    "The labels"
    labels: [String!] @sortable
    "The attribute IRI"
    attributeIri: String! @sortable
    "The attribute name"
    attributeName: String! @sortable
    "The attribute value"
    attributeValue: String! @sortable
    "The attribute display value"
    attributeDisplayValue: String @sortable
    "The attribute normalized value"
    attributeNormalizedValue: String @sortable
    "The attribute type"
    attributeType: AttributeType! @sortable
    "The GeoJSON geometry if this is a geospatial type"
    geometry: GeoJSON @sortable
    "The confidence"
    confidence: Confidence! @sortable
    "The source type"
    sourceType: SourceType @sortable
    "The source ID"
    sourceId: UUID! @sortable
    "The node ID to which this attribute is associated"
    nodeId: UUID @sortable
    "The observation ID to which this attribute is associated"
    observationId: UUID @sortable
    "The activity ID to which this attribute is associated"
    activityId: UUID @sortable
    "The authority value"
    authorityValue: AuthorityValue! @sortable
    "The user who set the authority value"
    authoritySetBy: String! @sortable
    "The time at which the authority value was set"
    authoritySetAtTime: DateTime! @sortable
    "The effective value start time"
    valueStart: DateTime @sortable
    "The effective value end time"
    valueEnd: DateTime @sortable
    "A flag to specify if an attribute may be modified by a user"
    isMutable: Boolean! @sortable
    "Has the attribute been reviewed"
    isReviewed: Boolean! @sortable
    "The authoritative flag"
    isAuthoritative: Boolean! @sortable
    "The isUserEntered flag"
    isUserEntered: Boolean! @sortable
    "The user who reviewed the attribute"
    reviewedBy: String @sortable
    "The time of the last review state change"
    reviewedAt: DateTime @sortable
    "Audit log events for this attribute"
    audits (
        "The audit filter"
        filter: AuditFilter
    ): AuditLogPage!
    "The object history for this attribute"
    history (
        "The history filter"
        filter: HistoryFilter
    ): AttributePage!
    "The resolvable source"
    source: Source
    "The resolvable node"
    node: Node
    "The observation"
    observation: Observation
    "The activity"
    activity: Activity
    "The comments associated with this attribute"
    comments (
        "The comment filter"
        filter: CommentFilter
    ): CommentPage!
    assessments (
        "The assessment filter"
        filter: AssessmentFilter
    ): AssessmentPage!
    "The resolvable ontology attribute"
    ontologyAttribute: OntologyAttribute
    "The most recent object verification"
    lastVerified: Verification!
}

"A page of attributes"
type AttributePage implements Page {
    "The total number of objects"
    totalSize: Long!
    "Whether the total size has been capped"
    totalSizeExceeded: Boolean!
    "The rollup ACM"
    rollupAcm: ACM
    "The object data"
    data: [Attribute!]!
}

"""
A query for attribute objects
"""
input AttributeQuery {
    "A list of attribute IDs to match"
    ids: [UUID!] @ContainerNotEmpty
    "A list of tags to match"
    tags: [String!] @ContainerNotEmpty
    "A list of labels to match"
    labels: [String!] @ContainerNotEmpty
    "A list of attribute IRIs to match"
    attributeIris: [String!] @ContainerNotEmpty
    "An attribute name match query"
    attributeName: StringQuery
    "An attribute value match query"
    attributeValue: StringQuery
    "An attribute display value match query"
    attributeDisplayValue: StringQuery
    "An attribute normalized value match query"
    attributeNormalizedValue: StringQuery
    "An attribute type match query"
    attributeType: AttributeTypeQuery
    "A geo query"
    geometry: GeoQuery
    "A confidence match query"
    confidence: ConfidenceQuery
    "A source type match query"
    sourceType: SourceTypeQuery
    "A list of source IDs to match"
    sourceIds: [UUID!] @ContainerNotEmpty
    "A list of node IDs to match"
    nodeIds: [UUID!] @ContainerNotEmpty
    "A list of observation IDs to match"
    observationIds: [UUID!] @ContainerNotEmpty
    "A list of activity IDs to match"
    activityIds: [UUID!] @ContainerNotEmpty
    "A list of authority values to match"
    authorityValues: [AuthorityValue!] @ContainerNotEmpty
    "An authority set by match query"
    authoritySetBy: [String!] @ContainerNotEmpty
    "An authority set at time query"
    authoritySetAtTime: TimeQuery
    "A query for the value start time"
    valueStart: TimeQuery
    "A query for the value end time"
    valueEnd: TimeQuery
    "A query for the isMutable field"
    isMutable: Boolean
    "A query for the reviewed field"
    isReviewed: Boolean
    "A query for the authoritative flag"
    isAuthoritative: Boolean
    "A query for the isUserEntered flag"
    isUserEntered: Boolean
    "A query for the user who reviewed the attribute"
    reviewedBy: [String!] @ContainerNotEmpty
    "A query for the time of the last review state change"
    reviewedAt: TimeQuery
    "A string query for either the attribute name, value, display value, or normalized value"
    attributeNameOrValue: StringQuery
    "Paging parameters"
    pageParams: PageParams
}

"""
